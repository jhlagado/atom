ZapOpIYH:     .equ 28
ZapOpIYL:     .equ 29
ZapOpI:       .equ 32
ZapOpR:       .equ 33
ZapOpMemBC:   .equ 40
ZapOpMemDE:   .equ 41
ZapOpIndexIX: .equ 48
ZapOpIndexIY: .equ 49
ZapOpMemAbs:  .equ 50
ZapOpImm8:    .equ 51
ZapOpImm16:   .equ 52
ZapOpPortC:   .equ 53
ZapOpRel8:    .equ 54
ZapOpZero:    .equ 55
