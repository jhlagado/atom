; Parsed instruction offsets.
ZapInstrMnemonic: .equ 0
ZapInstrOp0:      .equ 1
ZapInstrOp1:      .equ 2
ZapInstrOp2:      .equ 3
ZapInstrValue0:   .equ 4
ZapInstrValue1:   .equ 6
ZapInstrValue2:   .equ 8

; Operand classes. Register encodings retain the hardware opcode bit pattern.
