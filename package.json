{
  "name": "atom-z80",
  "version": "0.3.0",
  "description": "atom: a streaming Z80 assembler that runs on a Z80",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhlagado/atom.git"
  },
  "bugs": {
    "url": "https://github.com/jhlagado/atom/issues"
  },
  "homepage": "https://github.com/jhlagado/atom#readme",
  "keywords": [
    "z80",
    "assembler",
    "tec-1"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "atom": "bin/atom.mjs",
    "azm-to-atom": "bin/azm-to-atom.mjs"
  },
  "exports": {
    ".": "./src/host/index.mjs",
    "./native-builder": {
      "types": "./scripts/native-object-harness-builder.d.mts",
      "import": "./scripts/native-object-harness-builder.mjs"
    }
  },
  "files": [
    "assets/native-core.json",
    "assets/atom-cpm22.com",
    "assets/atom-object-harness.bin",
    "bin",
    "docs/*.md",
    "docs/codebase",
    "examples",
    "native/*.asm",
    "native/atom-symbols.json",
    "scripts/native-object-harness-builder.mjs",
    "scripts/native-object-harness-builder.d.mts",
    "src/abi.mjs",
    "src/host",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:native-core && npm run build:native-object && npm run build:cpm22",
    "build:native-core": "node scripts/generate-native-core.mjs",
    "build:native-object": "node scripts/generate-native-object-harness.mjs",
    "build:cpm22": "node scripts/generate-cpm22.mjs",
    "verify:cpm22": "node scripts/generate-cpm22.mjs --check",
    "verify:cpm22-output-candidates": "node scripts/measure-cpm22-output-candidates.mjs --check",
    "verify:native-core": "node scripts/generate-native-core.mjs --check",
    "verify:native-object": "node scripts/generate-native-object-harness.mjs --check",
    "verify:strict-contracts": "node scripts/generate-native-core.mjs --check",
    "verify:native-source": "node scripts/generate-native-core.mjs --check",
    "verify:self-host-source": "npm run verify:native-source",
    "verify:example": "node scripts/verify-example.mjs",
    "annotate:contracts": "npm run verify:strict-contracts",
    "verify:dependencies": "node scripts/verify-dependencies.mjs",
    "verify:package-census": "node scripts/package-census.mjs --check",
    "update:package-census": "node scripts/package-census.mjs --update",
    "prepare:proof": "npm run verify:dependencies",
    "pretest": "npm run prepare:proof && npm run verify:native-source && npm run verify:native-object && npm run verify:cpm22 && npm run verify:cpm22-output-candidates",
    "test": "node --test test/*.test.mjs",
    "test:host": "node --test test/host-*.test.mjs",
    "test:package": "node --test test/host-package.test.mjs",
    "premeasure": "npm run prepare:proof",
    "measure": "node test/measure.mjs",
    "measure:symbols": "node test/measure-symbols.mjs",
    "measure:tokenizer": "node test/measure-tokenizer.mjs",
    "measure:parser": "node test/measure-parser.mjs",
    "measure:expression": "node test/measure-expression.mjs",
    "measure:integration": "node test/measure-integration.mjs",
    "measure:output": "node test/measure-output.mjs",
    "measure:statements": "node test/measure-statements.mjs",
    "measure:driver": "node test/measure-driver.mjs",
    "measure:host-native": "node test/measure-host-native.mjs",
    "measure:self-host": "node test/measure-self-host.mjs",
    "measure:cpm22": "node test/measure-cpm22.mjs",
    "measure:cpm22-output-candidates": "node scripts/measure-cpm22-output-candidates.mjs",
    "release:check": "npm test && npm run verify:strict-contracts && node test/measure-host-native.mjs && node test/measure-self-host.mjs",
    "prepack": "npm run verify:native-source && npm run verify:native-object && npm run verify:cpm22 && node scripts/bundled-dependencies.mjs prepare",
    "postpack": "node scripts/bundled-dependencies.mjs cleanup",
    "prepublishOnly": "npm run release:check"
  },
  "dependencies": {
    "@jhlagado/debug80-runtime": "git+https://github.com/jhlagado/debug80-runtime.git#b7343aa8c38c248abbc6ee801b4af270d4843ad6",
    "@jhlagado/z80-tool-services": "git+https://github.com/jhlagado/z80-tool-services.git#6313682d4a9bc3d08d32c11fe054d153ce350720"
  },
  "devDependencies": {
    "@jhlagado/azm": "^0.3.9"
  },
  "peerDependencies": {
    "@jhlagado/azm": "^0.3.9"
  },
  "peerDependenciesMeta": {
    "@jhlagado/azm": {
      "optional": true
    }
  },
  "bundledDependencies": [
    "@jhlagado/debug80-runtime",
    "@jhlagado/z80-tool-services"
  ],
  "engines": {
    "node": ">=20"
  }
}
