.JR:
LD   A,(IX+EN_OP1)
CP   EN_NONE
JR   NZ,.JCONDIT1
LD   A,$18
LD   (EN_SCRAT+0),A
LD   A,(IX+EN_VAL0)
LD   (EN_SCRAT+1),A
JP   .D2
