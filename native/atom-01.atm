CP   EN_NONE
JR   NZ,.CCONDITI
LD   A,$CD
LD   (EN_SCRAT+0),A
CALL AT_CV0TS
JP   .D3
.CCONDITI:
LD   A,(IX+EN_OP0)
SUB  EN_NZ
ADD  A,A
ADD  A,A
ADD  A,A
ADD  A,$C4
