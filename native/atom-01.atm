CP   EN_IMM8
JR   Z,.IIMMEDIA
LD   A,$ED
LD   (EN_SCRAT+0),A
LD   A,(IX+EN_OP0)
ADD  A,A
ADD  A,A
ADD  A,A
ADD  A,$40
LD   (EN_SCRAT+1),A
JP   .D2
.INBARE:
LD   A,$70
JR   .INED
.IIMMEDIA:
LD   A,$DB
LD   (EN_SCRAT+0),A
LD   A,(IX+EN_VAL1)
LD   (EN_SCRAT+1),A
JP   .D2
.INED:
LD   B,A
LD   A,$ED
LD   (EN_SCRAT+0),A
LD   A,B
LD   (EN_SCRAT+1),A
JP   .D2
.OUT:
LD   A,(IX+EN_OP0)
CP   EN_IMM8
JR   Z,.OIMMEDIA
LD   A,(IX+EN_OP1)
CP   EN_ZERO
LD   A,$71
JP   Z,.INED
LD   A,(IX+EN_OP1)
ADD  A,A
ADD  A,A
ADD  A,A
ADD  A,$41
JR   .INED
.OIMMEDIA:
LD   A,$D3
LD   (EN_SCRAT+0),A
LD   A,(IX+EN_VAL0)
LD   (EN_SCRAT+1),A
JP   .D2
.BIT:
LD   A,(IX+EN_MNEM)
SUB  AT_MBIT-1
ADD  A,A
ADD  A,A
ADD  A,A
ADD  A,A
ADD  A,A
ADD  A,A
LD   B,A
LD   A,(IX+EN_OP0)
AND  7
ADD  A,A
ADD  A,A
ADD  A,A
ADD  A,B
LD   B,A
LD   A,(IX+EN_OP1)
CALL EN_IINDE
JR   C,.BINDEXED
LD   A,(IX+EN_OP1)
AND  7
ADD  A,B
LD   B,A
LD   A,$CB
LD   (EN_SCRAT+0),A
LD   A,B
LD   (EN_SCRAT+1),A
JP   .D2
.BINDEXED:
LD   A,(IX+EN_OP2)
CP   EN_NONE
LD   A,6
JR   Z,.BIC
LD   A,(IX+EN_OP2)
AND  7
.BIC:
ADD  A,B
LD   B,A
LD   A,(IX+EN_OP1)
;@EXPECTOUT A
CALL EN_PFOP
LD   (EN_SCRAT+0),A
LD   A,$CB
LD   (EN_SCRAT+1),A
LD   A,(IX+EN_VAL1)
LD   (EN_SCRAT+2),A
LD   A,B
LD   (EN_SCRAT+3),A
JP   .D4
.ROTATE:
LD   A,(IX+EN_MNEM)
SUB  AT_MRLC
LD   E,A
LD   D,0
LD   HL,EN_RBASE
ADD  HL,DE
LD   B,(HL)
LD   A,(IX+EN_OP0)
CALL EN_IINDE
JR   C,.RINDEXED
LD   A,(IX+EN_OP0)
AND  7
ADD  A,B
LD   B,A
LD   A,$CB
LD   (EN_SCRAT+0),A
LD   A,B
LD   (EN_SCRAT+1),A
JP   .D2
.RINDEXED:
LD   A,(IX+EN_OP1)
CP   EN_NONE
LD   A,6
JR   Z,.RIC
LD   A,(IX+EN_OP1)
AND  7
.RIC:
ADD  A,B
LD   B,A
LD   A,(IX+EN_OP0)
;@EXPECTOUT A
CALL EN_PFOP
LD   (EN_SCRAT+0),A
LD   A,$CB
LD   (EN_SCRAT+1),A
LD   A,(IX+EN_VAL0)
LD   (EN_SCRAT+2),A
LD   A,B
LD   (EN_SCRAT+3),A
JP   .D4
.ALU:
LD   A,(IX+EN_MNEM)
SUB  AT_MADD
LD   E,A
LD   D,0
LD   HL,EN_AORDE
ADD  HL,DE
LD   A,(HL)
ADD  A,A
ADD  A,A
ADD  A,A
LD   B,A
LD   A,(IX+EN_OP1)
CP   EN_NONE
JR   NZ,.ALU16
LD   A,(IX+EN_OP0)
CP   EN_IMM8
JR   Z,.AIMMEDIA
CALL EN_IHIND
JR   C,.ALUHALF
LD   A,(IX+EN_OP0)
CALL EN_IINDE
JR   C,.AINDEXED
LD   A,(IX+EN_OP0)
AND  7
ADD  A,B
ADD  A,$80
JP   .SE1
.AIMMEDIA:
LD   A,B
ADD  A,$C6
LD   (EN_SCRAT+0),A
LD   A,(IX+EN_VAL0)
LD   (EN_SCRAT+1),A
JP   .D2
.ALUHALF:
LD   A,(IX+EN_OP0)
PUSH AF
;@EXPECTOUT A
CALL EN_PFOP
LD   (EN_SCRAT+0),A
POP  AF
AND  7
ADD  A,B
ADD  A,$80
LD   (EN_SCRAT+1),A
JP   .D2
.AINDEXED:
PUSH AF
;@EXPECTOUT A
CALL EN_PFOP
LD   (EN_SCRAT+0),A
POP  AF
LD   A,B
ADD  A,$86
LD   (EN_SCRAT+1),A
LD   A,(IX+EN_VAL0)
LD   (EN_SCRAT+2),A
JP   .D3
.ALU16:
LD   A,(IX+EN_MNEM)
CP   AT_MADD
JR   Z,.ADD16
LD   B,$42
CP   AT_MSBC
JR   Z,.AS1READY
LD   B,$4A
.AS1READY:
LD   A,(IX+EN_OP1)
AND  3
ADD  A,A
ADD  A,A
ADD  A,A
ADD  A,A
ADD  A,B
LD   B,A
LD   A,$ED
LD   (EN_SCRAT+0),A
LD   A,B
LD   (EN_SCRAT+1),A
JP   .D2
.ADD16:
LD   A,(IX+EN_OP1)
CP   EN_IX
JR   Z,.A1SELF
CP   EN_IY
JR   Z,.A1SELF
AND  3
JR   .A1SREADY
.A1SELF:
LD   A,2
.A1SREADY:
ADD  A,A
ADD  A,A
ADD  A,A
ADD  A,A
ADD  A,$09
LD   B,A
LD   A,(IX+EN_OP0)
CP   EN_HL
LD   A,B
JP   Z,.SE1
LD   A,(IX+EN_OP0)
;@EXPECTOUT A
CALL EN_PFOP
LD   (EN_SCRAT+0),A
LD   A,B
LD   (EN_SCRAT+1),A
JP   .D2
.JP:
LD   A,(IX+EN_OP1)
CP   EN_NONE
JR   NZ,.JCONDITI
LD   A,(IX+EN_OP0)
CP   EN_MEMHL
JR   Z,.JPHL
CP   EN_MEMIX
JR   Z,.JPINDEX
CP   EN_MEMIY
JR   Z,.JPINDEX
LD   A,$C3
LD   (EN_SCRAT+0),A
CALL AT_CV0TS
JP   .D3
.JCONDITI:
LD   A,(IX+EN_OP0)
SUB  EN_NZ
ADD  A,A
ADD  A,A
ADD  A,A
ADD  A,$C2
LD   (EN_SCRAT+0),A
CALL AT_CV1TS
JP   .D3
.JPHL:
LD   A,$E9
JP   .SE1
.JPINDEX:
;@EXPECTOUT A
CALL EN_PFOP
LD   (EN_SCRAT+0),A
LD   A,$E9
LD   (EN_SCRAT+1),A
JP   .D2
.CALL:
