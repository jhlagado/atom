SY_SUPRI EQU 5
SY_SPCAP EQU 6
SY_SPINV EQU 7
SY_SADEF EQU 8
SY_SPCA1 EQU 9
;@ROUTINE IN HL,DE OUT A,CARRY CLOBBERS SIGN,PARITY,HALFCARRY,ZERO
SY_RESET:
LD   (SY_ABASE),HL
LD   (SY_GEND),HL
LD   (SY_AEND),DE
LD   (SY_LBEG),DE
XOR  A
LD   (SY_SACTI),A
RET
;@ROUTINE IN HL,DE OUT A,CARRY CLOBBERS SIGN,PARITY,HALFCARRY,ZERO
SY_RESE1:
LD   (SY_ABAS1),HL
LD   (SY_NEXT),HL
LD   (SY_AEND1),DE
XOR  A
RET
;@ROUTINE IN B,HL,DE OUT A,DE,CARRY CLOBBERS BC,HL,IX,SIGN,PARITY,HALFCARRY,ZERO
EN_PSYM:
LD   A,B
OR   A
JR   Z,.PSINVALI
LD   A,(HL)
CP   $2E
JR   NZ,.PSGLBL
DEC  B
JR   Z,.PSINVALI
LD   A,B
CP   9
JR   NC,.PSINVALI
INC  HL
LD   (SY_PDST),DE
;@EXPECTOUT DE,CARRY
CALL EN_R40PK
LD   A,0
ADC  A,0
OR   A
JR   NZ,.PSINVALI
LD   HL,(SY_PDST)
INC  HL
INC  HL
INC  HL
INC  HL
INC  HL
LD   A,(HL)
OR   SY_FPRIV
LD   (HL),A
XOR  A
RET
.PSGLBL:
;@EXPECTOUT DE,CARRY
CALL EN_R40PK
LD   A,0
ADC  A,0
OR   A
JR   NZ,.PSINVALI
XOR  A
RET
.PSINVALI:
XOR  A
INC  A
SCF
RET
;@ROUTINE IN HL OUT A,CARRY,IX CLOBBERS BC,HL,SIGN,PARITY,HALFCARRY,DE,ZERO
SY_FIND:
LD   (SY_OKEY),HL
PUSH HL
LD   DE,5
ADD  HL,DE
BIT  7,(HL)
POP  HL
JR   Z,.FINDGLBL
LD   A,(SY_SACTI)
OR   A
JR   Z,.PNSCOPE
LD   IX,(SY_LBEG)
LD   DE,(SY_AEND)
JR   .FINDLOOP
.FINDGLBL:
LD   IX,(SY_ABASE)
LD   DE,(SY_GEND)
.FINDLOOP:
PUSH IX
POP  HL
OR   A
SBC  HL,DE
JR   Z,.NOTFOUND
PUSH DE
;@EXPECTOUT ZERO
CALL SY_KEQUA
POP  DE
JR   Z,.FOUND
LD   BC,SY_RECB
ADD  IX,BC
JR   .FINDLOOP
.FOUND:
XOR  A
RET
.NOTFOUND:
LD   A,SY_SNFOU
SCF
RET
.PNSCOPE:
LD   A,SY_SPNSC
SCF
RET
;@ROUTINE IN IX OUT ZERO CLOBBERS DE,HL,SIGN,PARITY,HALFCARRY,B,CARRY,A
SY_KEQUA:
PUSH IX
POP  DE
LD   HL,(SY_OKEY)
LD   B,5
.KELOOP:
LD   A,(DE)
CP   (HL)
RET  NZ
INC  DE
INC  HL
DJNZ .KELOOP
LD   A,(DE)
XOR  (HL)
AND  SY_NHMAS
RET
;@ROUTINE IN HL,DE OUT A,CARRY,IX CLOBBERS BC,DE,HL,SIGN,PARITY,HALFCARRY,ZERO
SY_DECL:
LD   (SY_OKEY),HL
LD   (SY_OVAL),DE
;@EXPECTOUT A,CARRY,IX
CALL SY_FIND
JR   C,.DMISSING
BIT  6,(IX+5)
JR   NZ,.DUPLICAT
LD   DE,(SY_OVAL)
LD   (IX+SY_VALLO),E
LD   (IX+SY_VALHI),D
LD   A,(IX+5)
OR   SY_FDEFI
LD   (IX+5),A
XOR  A
RET
.DUPLICAT:
LD   A,SY_SDUPL
SCF
RET
.DMISSING:
CP   SY_SNFOU
JR   Z,.DINSERT
SCF
RET
.DINSERT:
LD   A,SY_FDEFI
;@EXPECTOUT A,CARRY,IX
CALL SY_INSER
RET
;@ROUTINE IN HL OUT A,CARRY,IX,B CLOBBERS C,DE,HL,ZERO,SIGN,PARITY,HALFCARRY
SY_REF:
LD   (SY_OKEY),HL
;@EXPECTOUT A,CARRY,IX
CALL SY_FIND
JR   C,.RMISSING
LD   B,0
RET
.RMISSING:
CP   SY_SNFOU
JR   Z,.RINSERT
SCF
RET
.RINSERT:
XOR  A
LD   (SY_OVAL),A
LD   (SY_OVAL+1),A
;@EXPECTOUT A,CARRY,IX
CALL SY_INSER
RET  C
LD   B,1
RET
;@ROUTINE IN A OUT A,CARRY,IX CLOBBERS BC,DE,HL,SIGN,PARITY,HALFCARRY,ZERO
SY_INSER:
LD   (SY_OFLAG),A
LD   HL,(SY_LBEG)
LD   DE,(SY_GEND)
OR   A
SBC  HL,DE
JR   C,.NOCAP
LD   A,H
OR   A
JR   NZ,.HASCAP
LD   A,L
CP   SY_RECB
JR   C,.NOCAP
.HASCAP:
LD   HL,(SY_OKEY)
LD   DE,5
ADD  HL,DE
BIT  7,(HL)
JR   NZ,.IPRIVATE
LD   IX,(SY_GEND)
PUSH IX
POP  HL
LD   DE,SY_RECB
ADD  HL,DE
LD   (SY_GEND),HL
JR   .CINSERT
.IPRIVATE:
LD   HL,(SY_LBEG)
LD   DE,SY_RECB
OR   A
SBC  HL,DE
LD   (SY_LBEG),HL
PUSH HL
POP  IX
.CINSERT:
LD   HL,(SY_OKEY)
PUSH IX
POP  DE
LD   BC,SY_NAMEB
LDIR
LD   A,(SY_OFLAG)
OR   (IX+5)
LD   (IX+5),A
LD   DE,(SY_OVAL)
LD   (IX+SY_VALLO),E
LD   (IX+SY_VALHI),D
XOR  A
RET
.NOCAP:
LD   A,SY_SSCAP
SCF
RET
;@ROUTINE OUT A,CARRY CLOBBERS BC,DE,HL,IX,ZERO,SIGN,PARITY,HALFCARRY
SY_ASCOP:
CALL SY_VSCOP
RET  C
SY_CSCOP:
LD   HL,(SY_AEND)
LD   (SY_LBEG),HL
LD   A,1
LD   (SY_SACTI),A
XOR  A
RET
;@ROUTINE IN HL,DE OUT A,CARRY,IX CLOBBERS BC,DE,HL,IY,ZERO,SIGN,PARITY,HALFCARRY
SY_DGLAB:
LD   (SY_OKEY),HL
LD   (SY_OVAL),DE
LD   DE,5
ADD  HL,DE
BIT  7,(HL)
JR   NZ,SY_GLPRI
LD   HL,(SY_OKEY)
CALL SY_FIND
JR   C,SY_GLMIS
BIT  6,(IX+5)
JR   NZ,SY_GLDUP
XOR  A
LD   (SY_OFLAG),A
JR   SY_GLVAL
SY_GLMIS:
CP   SY_SNFOU
RET  NZ
LD   A,1
LD   (SY_OFLAG),A
SY_GLVAL:
CALL SY_VSCOP
RET  C
LD   A,(SY_OFLAG)
OR   A
JR   Z,SY_GLCMT
LD   HL,(SY_AEND)
LD   DE,(SY_GEND)
OR   A
SBC  HL,DE
JR   C,SY_GLCAP
LD   A,H
OR   A
JR   NZ,SY_GLCMT
LD   A,L
CP   SY_RECB
JR   C,SY_GLCAP
SY_GLCMT:
LD   HL,(SY_AEND)
LD   (SY_LBEG),HL
LD   A,1
LD   (SY_SACTI),A
LD   HL,(SY_OKEY)
LD   DE,(SY_OVAL)
CALL SY_DECL
RET  NC
LD   A,SY_SPINV
SCF
RET
SY_GLPRI:
LD   A,SY_SPNSC
SCF
RET
SY_GLDUP:
LD   A,SY_SDUPL
SCF
RET
SY_GLCAP:
LD   A,SY_SSCAP
SCF
RET
;@ROUTINE OUT A,CARRY CLOBBERS IX,DE,BC,ZERO,SIGN,PARITY,HALFCARRY,HL
SY_VSCOP:
LD   IX,(SY_LBEG)
LD   DE,(SY_AEND)
SY_VSLOO:
PUSH IX
POP  HL
OR   A
SBC  HL,DE
JR   Z,SY_VPEND
BIT  6,(IX+5)
JR   Z,SY_VUNDE
LD   BC,SY_RECB
ADD  IX,BC
JR   SY_VSLOO
SY_VPEND:
LD   IX,(SY_ABAS1)
LD   DE,(SY_NEXT)
SY_VPLOO:
PUSH IX
POP  HL
OR   A
SBC  HL,DE
JR   Z,SY_VOK
LD   L,(IX+0)
LD   H,(IX+1)
PUSH DE
LD   DE,5
ADD  HL,DE
BIT  7,(HL)
POP  DE
JR   NZ,SY_VINVA
LD   BC,SY_RECB1
ADD  IX,BC
JR   SY_VPLOO
SY_VOK:
XOR  A
RET
SY_VUNDE:
LD   A,SY_SUPRI
SCF
RET
SY_VINVA:
LD   A,SY_SPINV
SCF
RET
;@ROUTINE IN IX,DE,BC OUT A,CARRY CLOBBERS DE,HL,SIGN,PARITY,HALFCARRY,ZERO
SY_ADD:
BIT  6,(IX+5)
JR   NZ,.ADEFINED
LD   (SY_OPATC),DE
LD   A,B
LD   (SY_OKIND),A
LD   A,C
LD   (SY_OAUX),A
PUSH IX
POP  HL
LD   (SY_OSYM),HL
LD   HL,(SY_AEND1)
LD   DE,(SY_NEXT)
OR   A
SBC  HL,DE
JR   C,.NOCAP
LD   A,H
OR   A
JR   NZ,.HASCAP
LD   A,L
CP   SY_RECB1
JR   C,.NOCAP
.HASCAP:
LD   DE,(SY_OPATC)
LD   HL,(SY_NEXT)
PUSH DE
LD   DE,(SY_OSYM)
LD   (HL),E
INC  HL
LD   (HL),D
INC  HL
POP  DE
LD   (HL),E
INC  HL
LD   (HL),D
INC  HL
LD   A,(SY_OKIND)
LD   (HL),A
INC  HL
LD   A,(SY_OAUX)
LD   (HL),A
INC  HL
LD   (SY_NEXT),HL
XOR  A
RET
.NOCAP:
LD   A,SY_SPCAP
SCF
RET
.ADEFINED:
LD   A,SY_SADEF
SCF
RET
;@ROUTINE OUT A,CARRY CLOBBERS DE,HL,ZERO,SIGN,PARITY,HALFCARRY
SY_CCAP:
LD   HL,(SY_AEND1)
LD   DE,(SY_NEXT)
OR   A
SBC  HL,DE
JR   C,SY_CNCAP
LD   A,H
OR   A
RET  NZ
LD   A,L
CP   SY_RECB1
JR   C,SY_CNCAP
XOR  A
RET
SY_CNCAP:
LD   A,SY_SPCAP
SCF
RET
;@ROUTINE IN IX OUT A,CARRY,BC,DE CLOBBERS IX,SIGN,PARITY,HALFCARRY,ZERO,HL
SY_PEEK:
PUSH IX
POP  HL
LD   (SY_OSYM),HL
LD   IX,(SY_ABAS1)
LD   DE,(SY_NEXT)
.PEEKLOOP:
PUSH IX
POP  HL
OR   A
SBC  HL,DE
JR   Z,.PNFOUND
LD   L,(IX+0)
LD   H,(IX+1)
PUSH DE
LD   DE,(SY_OSYM)
OR   A
SBC  HL,DE
POP  DE
JR   Z,.PFOUND
LD   BC,SY_RECB1
ADD  IX,BC
JR   .PEEKLOOP
.PFOUND:
LD   E,(IX+2)
LD   D,(IX+3)
LD   B,(IX+4)
LD   C,(IX+5)
XOR  A
RET
.PNFOUND:
LD   A,SY_SNFOU
SCF
RET
;@ROUTINE IN IX OUT A,CARRY MAYBE-OUT BC,DE CLOBBERS HL,IX,SIGN,PARITY,HALFCARRY,BC,DE,ZERO
SY_TAKE:
PUSH IX
POP  HL
LD   (SY_OSYM),HL
LD   IX,(SY_ABAS1)
LD   DE,(SY_NEXT)
.TAKELOOP:
PUSH IX
POP  HL
OR   A
SBC  HL,DE
JR   Z,.TNFOUND
LD   L,(IX+0)
LD   H,(IX+1)
PUSH DE
LD   DE,(SY_OSYM)
OR   A
SBC  HL,DE
POP  DE
JR   Z,.TFOUND
LD   BC,SY_RECB1
ADD  IX,BC
JR   .TAKELOOP
.TFOUND:
LD   E,(IX+2)
LD   D,(IX+3)
LD   B,(IX+4)
LD   C,(IX+5)
LD   (SY_OPATC),DE
LD   A,B
LD   (SY_OKIND),A
LD   A,C
LD   (SY_OAUX),A
LD   HL,(SY_NEXT)
LD   DE,SY_RECB1
OR   A
SBC  HL,DE
LD   (SY_NEXT),HL
PUSH IX
POP  DE
OR   A
SBC  HL,DE
JR   Z,.TRETURN
LD   HL,(SY_NEXT)
PUSH IX
POP  DE
LD   BC,SY_RECB1
LDIR
.TRETURN:
LD   DE,(SY_OPATC)
LD   A,(SY_OKIND)
LD   B,A
LD   A,(SY_OAUX)
LD   C,A
XOR  A
RET
.TNFOUND:
LD   A,SY_SNFOU
SCF
RET
SY_CEND:
SY_WBEG:
SY_ABASE: DW 0
SY_AEND: DW 0
SY_GEND: DW 0
SY_LBEG: DW 0
SY_SACTI: DB 0
SY_OKEY: DW 0
SY_OVAL: DW 0
SY_OFLAG: DB 0
SY_PDST: DW 0
SY_ABAS1: DW 0
SY_AEND1: DW 0
SY_NEXT: DW 0
SY_OSYM: DW 0
SY_OPATC: DW 0
SY_OKIND: DB 0
SY_OAUX: DB 0
SY_WEND:
TK_CBEG:
TK_EOF EQU 0
TK_EOL EQU 1
TK_NAME EQU 2
TK_DIR EQU 3
TK_NUMBE EQU 4
TK_STRIN EQU 5
TK_COMMA EQU 6
TK_COLON EQU 7
TK_LPARE EQU 8
TK_RPARE EQU 9
TK_PLUS EQU 10
TK_MINUS EQU 11
TK_STAR EQU 12
TK_SLASH EQU 13
TK_PERCE EQU 14
TK_AMPER EQU 15
TK_CARET EQU 16
TK_PIPE EQU 17
TK_TILDE EQU 18
TK_APOST EQU 19
TK_LSHIF EQU 20
TK_RSHIF EQU 21
TK_CUR EQU 22
TK_SIB EQU 1
TK_SNTLO EQU 2
TK_SINUM EQU 3
TK_SNOVE EQU 4
TK_SUSTR EQU 5
TK_SIESC EQU 6
TK_SSTLO EQU 7
TK_SBSRA EQU 8
TK_SUDIR EQU 9
TK_SUCHA EQU 10
TK_SICHA EQU 11
TK_KOFF EQU 0
TK_POFF EQU 1
TK_SOFF EQU 2
TK_LOFF EQU 4
TK_LOFF1 EQU 6
TK_VOFF EQU 7
TK_RECB EQU 9
;@ROUTINE IN A,HL,DE OUT A,IX,CARRY CLOBBERS SIGN,PARITY,HALFCARRY,ZERO
TK_RESET:
PUSH AF
PUSH HL
PUSH DE
EX   DE,HL
OR   A
SBC  HL,DE
JR   C,.RBSRANGE
POP  DE
POP  HL
POP  AF
LD   (TK_SPART),A
LD   (TK_SCURS),HL
LD   (TK_SEND),DE
XOR  A
LD   (TK_SOSTA),A
LD   (TK_SOSTA+1),A
LD   (TK_LHTOK),A
LD   (TK_EPEND),A
LD   (TK_ESTAT),A
LD   (TK_REC+TK_KOFF),A
LD   IX,TK_REC
RET
.RBSRANGE:
POP  DE
POP  HL
POP  AF
.BSRANGE:
LD   A,TK_SBSRA
SCF
RET
;@ROUTINE OUT A,CARRY,ZERO CLOBBERS DE,HL,SIGN,PARITY,HALFCARRY
TK_SPEEK:
LD   HL,(TK_SCURS)
LD   DE,(TK_SEND)
OR   A
SBC  HL,DE
JR   Z,.SPEOF
ADD  HL,DE
.SRCPEEKB:
LD   A,(HL)
OR   A
RET
.SPEOF:
SCF
RET
;@ROUTINE OUT A,CARRY,ZERO CLOBBERS DE,HL,SIGN,PARITY,HALFCARRY
TK_STAKE:
PUSH BC
CALL TK_SPEEK
JR   C,.STEOF
LD   B,A
LD   HL,(TK_SCURS)
INC  HL
LD   (TK_SCURS),HL
LD   HL,(TK_SOSTA)
INC  HL
LD   (TK_SOSTA),HL
LD   A,B
POP  BC
OR   A
RET
.STEOF:
POP  BC
SCF
RET
;@ROUTINE OUT CARRY,ZERO CLOBBERS A,HL,SIGN,PARITY,HALFCARRY
TK_BEG:
LD   HL,(TK_SCURS)
LD   (TK_SPTR),HL
LD   HL,(TK_SOSTA)
LD   (TK_SOFF1),HL
XOR  A
LD   (TK_SLEN),A
LD   (TK_SVAL),A
LD   (TK_SVAL+1),A
RET
;@ROUTINE IN A OUT A,IX,CARRY CLOBBERS HL,SIGN,PARITY,HALFCARRY,ZERO
TK_CMT:
LD   (TK_REC+TK_KOFF),A
LD   A,(TK_SPART)
LD   (TK_REC+TK_POFF),A
LD   HL,(TK_SOFF1)
LD   (TK_REC+TK_SOFF),HL
LD   HL,(TK_SPTR)
LD   (TK_REC+TK_LOFF),HL
LD   A,(TK_SLEN)
LD   (TK_REC+TK_LOFF1),A
LD   HL,(TK_SVAL)
LD   (TK_REC+TK_VOFF),HL
LD   IX,TK_REC
LD   A,(TK_REC+TK_KOFF)
OR   A
RET
;@ROUTINE IN A OUT A,IX,CARRY CLOBBERS HL,ZERO,SIGN,PARITY,HALFCARRY
TK_FIN:
LD   (TK_PKIND),A
LD   A,1
LD   (TK_LHTOK),A
LD   A,(TK_PKIND)
JP   TK_CMT
;@ROUTINE IN A OUT A,CARRY CLOBBERS HL,HALFCARRY,SIGN,PARITY,ZERO
TK_FAIL:
LD   (TK_ESTAT),A
LD   A,(TK_SPART)
LD   (TK_EPART),A
LD   HL,(TK_SOFF1)
LD   (TK_EOFF),HL
LD   A,(TK_ESTAT)
SCF
RET
;@ROUTINE IN A OUT A,CARRY CLOBBERS C,SIGN,PARITY,HALFCARRY,ZERO
TK_ILETT:
LD   C,A
OR   $20
SUB  $61
CP   26
LD   A,C
RET
;@ROUTINE IN A OUT A,CARRY CLOBBERS C,ZERO,SIGN,PARITY,HALFCARRY
TK_INBEG:
CALL TK_ILETT
RET  C
CP   $5F
JR   Z,TK_CYES
OR   A
RET
;@ROUTINE IN A OUT A,CARRY CLOBBERS C,ZERO,SIGN,PARITY,HALFCARRY
TK_INB:
CALL TK_INBEG
RET  C
CP   $30
JR   C,TK_CNO
CP   $39+1
RET  C
TK_CNO:
OR   A
RET
TK_CYES:
SCF
RET
;@ROUTINE IN A OUT A,CARRY CLOBBERS ZERO,SIGN,PARITY,HALFCARRY
TK_HDIGI:
CP   $30
JR   C,.HEXNO
CP   $39+1
JR   C,.HDECIMAL
OR   $20
SUB  $61
CP   6
JR   NC,.HEXNO
ADD  A,10
SCF
RET
.HDECIMAL:
SUB  $30
SCF
RET
.HEXNO:
OR   A
RET
;@ROUTINE OUT A,IX,CARRY CLOBBERS BC,DE,HL,ZERO,SIGN,PARITY,HALFCARRY
TK_SNAME:
LD   A,8
LD   (TK_NLIM),A
CALL TK_SPEEK
CP   $2E
JR   NZ,.SNGLBL
LD   A,9
LD   (TK_NLIM),A
CALL TK_STAKE
CALL TK_SPEEK
JP   C,TK_IB
CALL TK_INBEG
JP   NC,TK_IB
LD   B,1
JR   .SNLOOP
.SNGLBL:
LD   B,0
.SNLOOP:
CALL TK_SPEEK
JR   C,.SNDONE
CALL TK_INB
JR   NC,.SNDONE
INC  B
LD   A,(TK_NLIM)
CP   B
JR   C,TK_NTLON
CALL TK_STAKE
JR   .SNLOOP
.SNDONE:
LD   A,B
LD   (TK_SLEN),A
LD   A,TK_NAME
JP   TK_FIN
TK_NTLON:
LD   A,TK_SNTLO
JP   TK_FAIL
;@ROUTINE OUT A,IX,CARRY CLOBBERS BC,DE,HL,ZERO,SIGN,PARITY,HALFCARRY
TK_SDLED:
LD   HL,(TK_SCURS)
LD   DE,(TK_SEND)
LD   B,0
.SDLLOOK:
LD   A,H
CP   D
JR   NZ,.SDLB
LD   A,L
CP   E
JR   Z,.SDLSELEC
.SDLB:
LD   A,(HL)
CALL TK_INB
JR   NC,.SDLSELEC
INC  HL
INC  B
JP   Z,TK_INUMB
JR   .SDLLOOK
.SDLSELEC:
LD   A,B
LD   (TK_SLEN),A
DEC  HL
LD   A,(HL)
AND  $DF
LD   C,0
CP   $48
JR   Z,.SDLHEX
CP   $42
JR   NZ,.SDLPREPA
INC  C
JR   .SDLSUFFI
.SDLHEX:
LD   C,4
.SDLSUFFI:
DEC  B
.SDLPREPA:
LD   A,B
OR   A
JP   Z,TK_INUMB
LD   (TK_DSEEN),A
LD   IX,(TK_SPTR)
LD   HL,0
LD   A,C
OR   A
JR   Z,.SDLDECIM
CP   1
JR   Z,.SDLBINAR
.SDLHLOOP:
LD   A,(IX+0)
CALL TK_HDIGI
JP   NC,TK_INUMB
LD   E,A
LD   A,H
AND  $F0
JP   NZ,TK_NOVER
ADD  HL,HL
ADD  HL,HL
ADD  HL,HL
ADD  HL,HL
LD   A,L
OR   E
LD   L,A
INC  IX
LD   A,(TK_DSEEN)
DEC  A
LD   (TK_DSEEN),A
JR   NZ,.SDLHLOOP
JR   .SDLFIN
.SDLBINAR:
LD   A,(IX+0)
SUB  $30
JP   C,TK_INUMB
CP   2
JP   NC,TK_INUMB
LD   E,A
ADD  HL,HL
JP   C,TK_NOVER
LD   A,L
OR   E
LD   L,A
INC  IX
LD   A,(TK_DSEEN)
DEC  A
LD   (TK_DSEEN),A
JR   NZ,.SDLBINAR
JR   .SDLFIN
.SDLDECIM:
LD   A,(IX+0)
SUB  $30
JP   C,TK_INUMB
CP   10
JP   NC,TK_INUMB
LD   C,A
LD   A,H
CP   $19
JR   C,.SDLDACCU
JP   NZ,TK_NOVER
LD   A,L
CP   $99
JR   C,.SDLDACCU
JP   NZ,TK_NOVER
LD   A,C
CP   6
JP   NC,TK_NOVER
.SDLDACCU:
LD   D,0
LD   E,C
ADD  HL,HL
LD   B,H
LD   C,L
ADD  HL,HL
ADD  HL,HL
ADD  HL,BC
ADD  HL,DE
INC  IX
LD   A,(TK_DSEEN)
DEC  A
LD   (TK_DSEEN),A
JR   NZ,.SDLDECIM
.SDLFIN:
LD   (TK_SVAL),HL
LD   A,(TK_SLEN)
LD   C,A
LD   B,0
LD   HL,(TK_SPTR)
ADD  HL,BC
LD   (TK_SCURS),HL
LD   HL,(TK_SOFF1)
ADD  HL,BC
LD   (TK_SOSTA),HL
LD   A,TK_NUMBE
JP   TK_FIN
;@ROUTINE IN BC OUT A,IX,CARRY CLOBBERS BC,DE,HL,ZERO,SIGN,PARITY,HALFCARRY
TK_SBASE:
LD   HL,0
XOR  A
LD   (TK_DSEEN),A
.SBLOOP:
PUSH HL
CALL TK_SPEEK
POP  HL
JR   C,.SBEOF
LD   D,A
BIT  2,C
JR   Z,.SBDIGIT
CALL TK_HDIGI
