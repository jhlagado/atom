RET
;@ROUTINE IN IX CLOBBERS A
AT_CV1T1:
LD   A,(IX+EN_VAL1)
LD   (EN_SCRAT+2),A
LD   A,(IX+EN_VAL1+1)
LD   (EN_SCRAT+3),A
RET
;@ROUTINE IN A OUT A CLOBBERS F
EN_PFOP:
CP   EN_IXH
JR   C,.PORDINAR
CP   EN_IXL+1
JR   C,.PREFIXIX
CP   EN_IYH
JR   C,.PORDINAR
