JR   NC,.SBDONE
JR   .SBDIGIT1
.SBDIGIT:
SUB  $30
JR   C,.SBDONE
CP   2
JR   NC,.SBDONE
.SBDIGIT1:
LD   E,A
BIT  2,C
JR   Z,.SBSHIFT
LD   A,H
AND  $F0
JR   NZ,TK_NOVER
ADD  HL,HL
ADD  HL,HL
ADD  HL,HL
ADD  HL,HL
JR   .SBMERGE
.SBSHIFT:
ADD  HL,HL
JR   C,TK_NOVER
.SBMERGE:
LD   A,L
OR   E
LD   L,A
PUSH HL
CALL TK_STAKE
POP  HL
INC  B
JR   Z,TK_INUMB
LD   A,1
LD   (TK_DSEEN),A
JR   .SBLOOP
.SBDONE:
LD   A,(TK_DSEEN)
OR   A
JR   Z,TK_INUMB
LD   A,D
CALL TK_INB
JR   C,TK_INUMB
JR   .SBFIN
.SBEOF:
LD   A,(TK_DSEEN)
OR   A
JR   Z,TK_INUMB
.SBFIN:
LD   (TK_SVAL),HL
LD   A,B
LD   (TK_SLEN),A
LD   A,TK_NUMBE
JP   TK_FIN
TK_INUMB:
LD   A,TK_SINUM
JP   TK_FAIL
TK_NOVER:
LD   A,TK_SNOVE
JP   TK_FAIL
;@ROUTINE OUT A,IX,CARRY CLOBBERS DE,HL,ZERO,SIGN,PARITY,HALFCARRY,BC
TK_SSTRI:
LD   B,0
CALL TK_STAK1
JP   C,TK_FAIL
.SSLOOP:
CALL TK_STAK1
JP   C,TK_FAIL
CP   $0A
JR   Z,TK_USTRI
CP   $0D
JR   Z,TK_USTRI
CP   $20
JR   C,TK_IB
CP   $7F
JR   NC,TK_IB
CP   $22
JR   Z,.SSDONE
CP   $5C
JR   NZ,.SSLOOP
CALL TK_STAK1
JP   C,TK_FAIL
CP   $78
JR   Z,.SHESCAPE
LD   HL,TK_ETABL
LD   C,TK_ECNT
.SELOOP:
CP   (HL)
JR   Z,.SSLOOP
INC  HL
INC  HL
DEC  C
JR   NZ,.SELOOP
LD   A,TK_SIESC
JP   TK_FAIL
.SHESCAPE:
CALL TK_STAK1
JP   C,TK_FAIL
CALL TK_HDIGI
JR   NC,TK_IESCA
CALL TK_STAK1
JP   C,TK_FAIL
CALL TK_HDIGI
JR   NC,TK_IESCA
JR   .SSLOOP
.SSDONE:
LD   A,B
LD   (TK_SLEN),A
LD   A,TK_STRIN
JP   TK_FIN
;@ROUTINE IN B OUT A,B,CARRY CLOBBERS DE,HL,ZERO,SIGN,PARITY,HALFCARRY
TK_STAK1:
CALL TK_STAKE
JR   C,.STEOF
INC  B
RET  NZ
LD   A,TK_SSTLO
SCF
RET
.STEOF:
LD   A,TK_SUSTR
SCF
RET
TK_IESCA:
LD   A,TK_SIESC
JP   TK_FAIL
TK_USTRI:
LD   A,TK_SUSTR
JP   TK_FAIL
TK_UCHAR:
LD   A,TK_SUCHA
JP   TK_FAIL
TK_ICHAR:
LD   A,TK_SICHA
JP   TK_FAIL
TK_IB:
LD   A,TK_SIB
JP   TK_FAIL
;@ROUTINE OUT CARRY,ZERO CLOBBERS DE,HL,SIGN,PARITY,HALFCARRY,A
TK_SCOMM:
.SCLOOP:
CALL TK_SPEEK
RET  C
CP   $0A
RET  Z
CP   $0D
RET  Z
CALL TK_STAKE
JR   .SCLOOP
;@ROUTINE OUT A,IX,CARRY CLOBBERS BC,DE,HL,ZERO,SIGN,PARITY,HALFCARRY,IY
TK_NEXT:
.NEXTLOOP:
CALL TK_BEG
CALL TK_SPEEK
JP   C,.ATEOF
CP   $20
JR   Z,.SKIPB
CP   $09
JR   Z,.SKIPB
CP   $0A
JP   Z,.LF
CP   $0D
JP   Z,.CRLF
CP   $3B
JR   Z,.COMMENT
CP   $2E
JP   Z,TK_SNAME
CP   $22
JP   Z,TK_SSTRI
CP   $27
JP   Z,.APOSTROP
CP   $24
JP   Z,.DOLLAR
CP   $25
JP   Z,.PERCENT
CP   $3C
JP   Z,.LSHIFT
CP   $3E
JP   Z,.RSHIFT
CP   $30
JR   C,.TRYNAME
CP   $39+1
JP   C,TK_SDLED
.TRYNAME:
CALL TK_INBEG
JP   C,TK_SNAME
LD   HL,TK_PTABL
LD   B,TK_PCNT
.PLOOP:
CP   (HL)
INC  HL
JR   Z,.PUNCTUAT
INC  HL
DJNZ .PLOOP
JP   TK_IB
.PUNCTUAT:
LD   C,(HL)
CALL TK_STAKE
LD   A,1
LD   (TK_SLEN),A
LD   A,C
JP   TK_FIN
.SKIPB:
CALL TK_STAKE
JR   .NEXTLOOP
.COMMENT:
CALL TK_SCOMM
JR   .NEXTLOOP
.DOLLAR:
CALL TK_STAKE
CALL TK_SPEEK
JR   C,.CLOCATIO
LD   B,A
CALL TK_HDIGI
JR   C,.DNUMBER
LD   A,B
CALL TK_INB
JP   C,TK_INUMB
.CLOCATIO:
LD   A,1
LD   (TK_SLEN),A
LD   A,TK_CUR
JP   TK_FIN
.DNUMBER:
LD   B,1
LD   C,4
JP   TK_SBASE
.PERCENT:
CALL TK_STAKE
CALL TK_SPEEK
JR   C,.PTOK
CP   $30
JR   Z,.PNUMBER
CP   $31
JR   Z,.PNUMBER
CALL TK_ILETT
JR   NC,.PTOK
LD   A,(TK_LHTOK)
OR   A
JR   NZ,.PTOK
LD   A,TK_SUDIR
JP   TK_FAIL
.PTOK:
LD   A,1
LD   (TK_SLEN),A
LD   A,TK_PERCE
JP   TK_FIN
.PNUMBER:
LD   B,1
LD   C,1
JP   TK_SBASE
.LSHIFT:
LD   C,TK_LSHIF
JR   .SHIFT
.RSHIFT:
LD   C,TK_RSHIF
.SHIFT:
LD   B,A
CALL TK_STAKE
CALL TK_SPEEK
JP   C,TK_IB
CP   B
JP   NZ,TK_IB
CALL TK_STAKE
LD   A,2
LD   (TK_SLEN),A
LD   A,C
JP   TK_FIN
.LF:
CALL TK_STAKE
LD   A,1
LD   (TK_SLEN),A
JR   .FINLINE
.CRLF:
CALL TK_STAKE
CALL TK_SPEEK
JP   C,TK_IB
CP   $0A
JP   NZ,TK_IB
CALL TK_STAKE
LD   A,2
LD   (TK_SLEN),A
.FINLINE:
XOR  A
LD   (TK_EPEND),A
LD   A,(TK_LHTOK)
OR   A
JP   Z,.NEXTLOOP
XOR  A
LD   (TK_LHTOK),A
LD   A,TK_EOL
JP   TK_CMT
.ATEOF:
LD   A,(TK_EPEND)
OR   A
JR   NZ,.EMITEOF
LD   A,(TK_LHTOK)
OR   A
JR   Z,.EMITEOF
XOR  A
LD   (TK_LHTOK),A
INC  A
LD   (TK_EPEND),A
XOR  A
LD   (TK_SLEN),A
LD   A,TK_EOL
JP   TK_CMT
.EMITEOF:
XOR  A
LD   (TK_SLEN),A
JP   TK_CMT
.APOSTROP:
LD   HL,(TK_SOFF1)
LD   A,H
OR   L
JP   Z,TK_SCHAR
LD   HL,(TK_SPTR)
DEC  HL
LD   A,(HL)
CALL TK_INB
JP   NC,TK_SCHAR
CALL TK_STAKE
LD   A,1
LD   (TK_SLEN),A
LD   A,TK_APOST
JP   TK_FIN
;@ROUTINE OUT A,IX,CARRY CLOBBERS BC,DE,HL,IY,ZERO,SIGN,PARITY,HALFCARRY
TK_SCHAR:
LD   B,1
CALL TK_STAKE
CALL TK_STAKE
JP   C,TK_UCHAR
INC  B
CP   $0A
JP   Z,TK_UCHAR
CP   $0D
JP   Z,TK_UCHAR
CP   $27
JP   Z,TK_ICHAR
CP   $5C
JR   Z,.SCESCAPE
CP   $20
JP   C,TK_IB
CP   $7F
JP   NC,TK_IB
LD   (TK_SVAL),A
JR   .SCCLOSE
.SCESCAPE:
CALL TK_STAKE
JP   C,TK_UCHAR
INC  B
CP   $78
JR   Z,.SCHEX
LD   HL,TK_ETABL
LD   C,TK_ECNT
.SCELOOP:
CP   (HL)
JR   Z,.SCEFOUND
INC  HL
INC  HL
DEC  C
JR   NZ,.SCELOOP
JP   TK_IESCA
.SCEFOUND:
INC  HL
LD   A,(HL)
LD   (TK_SVAL),A
JR   .SCCLOSE
.SCHEX:
CALL TK_STAKE
JP   C,TK_UCHAR
INC  B
CALL TK_HDIGI
JP   NC,TK_IESCA
ADD  A,A
ADD  A,A
ADD  A,A
ADD  A,A
LD   (TK_SVAL),A
CALL TK_STAKE
JP   C,TK_UCHAR
INC  B
CALL TK_HDIGI
JP   NC,TK_IESCA
LD   HL,TK_SVAL
OR   (HL)
LD   (TK_SVAL),A
.SCCLOSE:
CALL TK_STAKE
JP   C,TK_UCHAR
INC  B
CP   $0A
JP   Z,TK_UCHAR
CP   $0D
JP   Z,TK_UCHAR
CP   $27
JP   NZ,TK_ICHAR
LD   A,B
LD   (TK_SLEN),A
LD   A,TK_NUMBE
JP   TK_FIN
TK_RCEND:
TK_IBEG:
TK_PTABL:
DB $2C,TK_COMMA
DB $3A,TK_COLON
DB $28,TK_LPARE
DB $29,TK_RPARE
DB $2B,TK_PLUS
DB $2D,TK_MINUS
DB $2A,TK_STAR
DB $2F,TK_SLASH
DB $26,TK_AMPER
DB $5E,TK_CARET
DB $7C,TK_PIPE
DB $7E,TK_TILDE
DB $27,TK_APOST
TK_PEND:
TK_PCNT EQU (TK_PEND-TK_PTABL)/2
TK_ETABL:
DB $30,0,$6E,$0A,$72,$0D,$74,$09,$27,$27,$22,$22,$5C,$5C
TK_ECNT EQU 7
TK_IEND:
TK_CEND:
TK_WBEG:
TK_SCURS: DW 0
TK_SEND: DW 0
TK_SOSTA: DW 0
TK_SPART: DB 0
TK_LHTOK: DB 0
TK_EPEND: DB 0
TK_SPTR: DW 0
TK_SOFF1: DW 0
TK_SLEN: DB 0
TK_SVAL: DW 0
TK_DSEEN: DB 0
TK_NLIM: DB 0
TK_PKIND: DB 0
TK_ESTAT: DB 0
TK_EPART: DB 0
TK_EOFF: DW 0
TK_REC: DS TK_RECB
TK_WEND:
EX_CBEG:
EX_RESOL EQU 0
EX_UNRES EQU 1
EX_SLEXI EQU 2
EX_SEPRI EQU 3
EX_SERIG EQU 4
EX_SDZER EQU 5
EX_SRANG EQU 6
EX_SFFOR EQU 7
EX_SCAP EQU 8
EX_SSYM EQU 9
EX_SINT EQU 10
EX_OPOR EQU 1
EX_OPXOR EQU 2
EX_OPAND EQU 3
EX_OLEFT EQU 4
EX_ORIGH EQU 5
EX_OPADD EQU 6
EX_OSUBT EQU 7
EX_OMULT EQU 8
EX_ODIVI EQU 9
EX_OREMA EQU 10
EX_VALB EQU 10
EX_VCAP EQU 16
EX_OPERB EQU 5
EX_OCAP EQU 16
EX_MLPAR EQU $7F
EX_UPLUS EQU $80+TK_PLUS
EX_UMINU EQU $80+TK_MINUS
EX_UTILD EQU $80+TK_TILDE
EX_ULO EQU $F0
EX_UHI EQU $F1
EX_FPLAI EQU 1
EX_FLO EQU 2
EX_FHI EQU 3
;@ROUTINE IN BC OUT A,HL,IX,CARRY CLOBBERS BC,DE,IY,ZERO,SIGN,PARITY,HALFCARRY
EX_PARSE:
LD   A,1
LD   (EX_PSYM),A
JR   EX_PCOMM
;@ROUTINE IN BC OUT A,HL,IX,CARRY CLOBBERS SIGN,PARITY,HALFCARRY,ZERO,BC,DE,IY
EX_PDEFR:
XOR  A
LD   (EX_PSYM),A
EX_PCOMM:
LD   (EX_CADR),BC
XOR  A
LD   (EX_VDEPT),A
LD   (EX_ODEPT),A
LD   (EX_PDEPT),A
INC  A
LD   (EX_EOP),A
.PLOOP:
LD   A,(EX_EOP)
OR   A
JR   Z,.POPER
CALL EX_POP
RET  C
JR   .PLOOP
.POPER:
CALL EX_POPER
RET  C
JR   NZ,.PLOOP
CALL EX_FSTAC
RET  C
LD   A,(EX_RUNRE)
OR   A
JR   NZ,.FUNRESOL
CALL EX_REQW
RET  C
LD   HL,(EX_RVAL)
XOR  A
RET
.FUNRESOL:
CALL EX_RADDE
RET  C
LD   A,(EX_PSYM)
OR   A
JR   Z,.FINDEFR
LD   HL,EX_RKEY
CALL SY_REF
JP   C,EX_SFAIL
LD   HL,(EX_RVAL)
LD   A,EX_UNRES
OR   A
RET
.FINDEFR:
LD   IX,EX_RKEY
LD   HL,(EX_RVAL)
LD   A,EX_UNRES
OR   A
RET
;@ROUTINE IN A OUT A,CARRY CLOBBERS HL,ZERO,SIGN,PARITY,HALFCARRY
EX_SFAIL:
LD   (EX_SSTAT),A
LD   A,EX_SSYM
JP   EX_FSYM
;@ROUTINE IN IX,HL,DE,B OUT A,CARRY CLOBBERS C,DE,HL,ZERO,SIGN,PARITY,HALFCARRY
EX_QUEUE:
LD   C,L
JP   SY_ADD
;@ROUTINE OUT A,CARRY CLOBBERS BC,DE,HL,IX,ZERO,SIGN,PARITY,HALFCARRY
EX_CFUNC:
LD   A,(TK_REC+TK_LOFF1)
CP   3
JR   Z,.CLSLO
CP   4
JR   NZ,.NFUNCTIO
LD   C,EX_UHI
LD   DE,$336F
JR   .CFPACK
.CLSLO:
LD   C,EX_ULO
LD   DE,$4D6F
.CFPACK:
PUSH DE
PUSH BC
LD   HL,(TK_REC+TK_LOFF)
LD   B,A
LD   DE,EX_RKEY
CALL EN_R40PK
POP  BC
POP  DE
JR   C,.NFUNCTIO
LD   HL,(EX_RKEY)
OR   A
SBC  HL,DE
JR   NZ,.NFUNCTIO
LD   HL,(TK_SCURS)
LD   DE,(TK_SEND)
.FLOOKAHE:
LD   A,H
CP   D
JR   NZ,.FLB
LD   A,L
CP   E
JR   Z,.NFUNCTIO
.FLB:
LD   A,(HL)
CP   $20
JR   Z,.FLSPACE
CP   $09
JR   Z,.FLSPACE
CP   $28
JR   NZ,.NFUNCTIO
LD   A,C
OR   A
RET
.FLSPACE:
INC  HL
JR   .FLOOKAHE
.NFUNCTIO:
SCF
RET
;@ROUTINE OUT A,CARRY CLOBBERS HL,ZERO,SIGN,PARITY,HALFCARRY,BC,DE,IX,IY
EX_POP:
LD   A,(TK_REC+TK_KOFF)
CP   TK_PLUS
JR   Z,.PUNARY
CP   TK_MINUS
JR   Z,.PUNARY
CP   TK_TILDE
JR   Z,.PUNARY
CP   TK_NUMBE
JR   Z,.PNUMBER
CP   TK_CUR
JR   Z,.PCUR
CP   TK_NAME
JR   Z,.PNAME
CP   TK_LPARE
JR   Z,.PPAREN
LD   A,EX_SEPRI
JP   EX_FHERE
.PUNARY:
ADD  A,$80
LD   (EX_OPER),A
LD   A,7
LD   (EX_OPREC),A
CALL EX_COPOS
CALL EX_POPE1
RET  C
JP   EX_NTOK
.PPAREN:
LD   A,EX_MLPAR
LD   (EX_OPER),A
XOR  A
LD   (EX_OPREC),A
CALL EX_COPOS
CALL EX_POPE1
RET  C
LD   HL,EX_PDEPT
INC  (HL)
JP   EX_NTOK
.PNUMBER:
LD   HL,(TK_REC+TK_VOFF)
CALL EX_SRW
JR   .PFIN
.PCUR:
LD   HL,(EX_CADR)
CALL EX_SRW
JR   .PFIN
.PNAME:
CALL EX_CFUNC
JR   NC,.PFUNCTIO
CALL EX_PNAME
RET  C
JR   .PPUBLISH
.PFIN:
CALL EX_NTOK
RET  C
.PPUBLISH:
CALL EX_PVAL
RET  C
CALL EX_AUNAR
RET  C
XOR  A
LD   (EX_EOP),A
RET
.PFUNCTIO:
LD   (EX_OPER),A
LD   A,7
LD   (EX_OPREC),A
CALL EX_COPOS
CALL EX_POPE1
RET  C
CALL EX_NTOK
RET  C
LD   A,(TK_REC+TK_KOFF)
CP   TK_LPARE
JP   Z,.PPAREN
LD   A,EX_SEPRI
JP   EX_FHERE
;@ROUTINE OUT A,CARRY,ZERO CLOBBERS BC,DE,HL,IX,IY,SIGN,PARITY,HALFCARRY
EX_POPER:
LD   A,(TK_REC+TK_KOFF)
CP   TK_RPARE
JR   Z,.RPAREN
CALL EX_COPER
JR   C,.DELIMITE
CALL EX_SINCO
CALL EX_RINC1
RET  C
CALL EX_RINCO
CALL EX_POPE1
RET  C
LD   A,1
LD   (EX_EOP),A
CALL EX_NTOK
RET  C
LD   A,1
OR   A
RET
.RPAREN:
LD   A,(EX_PDEPT)
OR   A
JR   Z,.DELIMITE
CALL EX_RTPAR
RET  C
CALL EX_POPE2
RET  C
LD   HL,EX_PDEPT
DEC  (HL)
CALL EX_NTOK
RET  C
CALL EX_AUNAR
RET  C
LD   A,1
OR   A
RET
.DELIMITE:
LD   A,(EX_PDEPT)
OR   A
JR   Z,.DDONE
LD   A,EX_SERIG
JP   EX_FHERE
.DDONE:
XOR  A
RET
;@ROUTINE OUT A,CARRY CLOBBERS BC,HL,IX,ZERO,SIGN,PARITY,HALFCARRY,DE,IY
EX_PNAME:
LD   A,(TK_REC+TK_POFF)
LD   (EX_SPART),A
LD   HL,(TK_REC+TK_SOFF)
LD   (EX_SOFF),HL
LD   HL,(TK_REC+TK_LOFF)
LD   A,(TK_REC+TK_LOFF1)
LD   B,A
LD   DE,EX_RKEY
CALL EN_PSYM
JP   C,EX_SFAIL
LD   HL,EX_RKEY
CALL SY_FIND
JR   C,.PMISSING
BIT  6,(IX+5)
JR   Z,.PUNRESOL
LD   L,(IX+SY_VALLO)
LD   H,(IX+SY_VALHI)
BIT  5,(IX+5)
JR   Z,.PPSYM
LD   (EX_RVAL),HL
LD   A,$FF
LD   (EX_RVAL+2),A
XOR  A
LD   (EX_RUNRE),A
JP   EX_NTOK
.PPSYM:
CALL EX_SRW
JP   EX_NTOK
.PMISSING:
CP   SY_SNFOU
JR   Z,.PUNRESOL
LD   (EX_SSTAT),A
LD   A,EX_SSYM
JP   EX_FSYM
.PUNRESOL:
XOR  A
LD   (EX_RVAL),A
LD   (EX_RVAL+1),A
LD   (EX_RVAL+2),A
INC  A
LD   (EX_RUNRE),A
JP   EX_NTOK
;@ROUTINE OUT A,CARRY CLOBBERS ZERO,SIGN,PARITY,HALFCARRY,C,HL
EX_COPER:
LD   A,(TK_REC+TK_KOFF)
CP   TK_PIPE
JR   Z,.OPEROR
CP   TK_CARET
JR   Z,.OPERXOR
CP   TK_AMPER
JR   Z,.OPERAND
CP   TK_LSHIF
JR   Z,.OPERLEFT
CP   TK_RSHIF
JR   Z,.ORIGHT
CP   TK_PLUS
JR   Z,.OPERADD
CP   TK_MINUS
JR   Z,.OSUBTRAC
CP   TK_STAR
JR   Z,.OMULTIPL
CP   TK_SLASH
JR   Z,.ODIVIDE
CP   TK_PERCE
JR   Z,.OREMAIND
SCF
RET
.OPEROR:
LD   A,EX_OPOR
LD   C,1
JR   .OSTORE
.OPERXOR:
LD   A,EX_OPXOR
LD   C,2
JR   .OSTORE
.OPERAND:
LD   A,EX_OPAND
LD   C,3
JR   .OSTORE
.OPERLEFT:
LD   A,EX_OLEFT
LD   C,4
JR   .OSTORE
.ORIGHT:
LD   A,EX_ORIGH
LD   C,4
JR   .OSTORE
.OPERADD:
LD   A,EX_OPADD
LD   C,5
JR   .OSTORE
.OSUBTRAC:
LD   A,EX_OSUBT
LD   C,5
JR   .OSTORE
.OMULTIPL:
LD   A,EX_OMULT
LD   C,6
JR   .OSTORE
.ODIVIDE:
LD   A,EX_ODIVI
LD   C,6
JR   .OSTORE
.OREMAIND:
LD   A,EX_OREMA
LD   C,6
.OSTORE:
LD   (EX_OPER),A
LD   A,C
LD   (EX_OPREC),A
CALL EX_COPOS
OR   A
RET
;@ROUTINE OUT CARRY,ZERO CLOBBERS A,HL,SIGN,PARITY,HALFCARRY
EX_COPOS:
LD   A,(TK_REC+TK_POFF)
LD   (EX_OPART),A
LD   HL,(TK_REC+TK_SOFF)
LD   (EX_OOFF),HL
RET
;@ROUTINE OUT A,CARRY CLOBBERS HL,ZERO,SIGN,PARITY,HALFCARRY,BC,DE
EX_PVAL:
LD   A,(EX_VDEPT)
CP   EX_VCAP
JP   NC,EX_CFAIL
CALL EX_VADR
LD   D,H
LD   E,L
LD   HL,EX_RVAL
LD   BC,EX_VALB
LDIR
LD   HL,EX_VDEPT
INC  (HL)
XOR  A
RET
;@ROUTINE OUT A,CARRY CLOBBERS HL,ZERO,SIGN,PARITY,HALFCARRY,BC,DE
EX_PVAL1:
LD   A,(EX_VDEPT)
OR   A
JP   Z,EX_IFAIL
DEC  A
LD   (EX_VDEPT),A
CALL EX_VADR
LD   DE,EX_RVAL
LD   BC,EX_VALB
LDIR
XOR  A
RET
;@ROUTINE OUT A,CARRY CLOBBERS HL,ZERO,SIGN,PARITY,HALFCARRY,BC,DE
EX_PLVAL:
LD   A,(EX_VDEPT)
OR   A
JP   Z,EX_IFAIL
DEC  A
LD   (EX_VDEPT),A
CALL EX_VADR
LD   DE,EX_LVAL
LD   BC,EX_VALB
LDIR
XOR  A
RET
;@ROUTINE IN A OUT HL CLOBBERS DE,A,F
EX_VADR:
LD   E,A
LD   D,0
LD   H,D
LD   L,E
ADD  HL,HL
ADD  HL,HL
ADD  HL,HL
EX   DE,HL
ADD  HL,HL
ADD  HL,DE
LD   DE,EX_VSTAC
ADD  HL,DE
RET
;@ROUTINE OUT A,CARRY CLOBBERS HL,ZERO,SIGN,PARITY,HALFCARRY,BC,DE
EX_POPE1:
LD   A,(EX_ODEPT)
CP   EX_OCAP
JP   NC,EX_CFAIL
CALL EX_OADR
LD   D,H
LD   E,L
LD   HL,EX_OPER
LD   BC,EX_OPERB
LDIR
LD   HL,EX_ODEPT
INC  (HL)
XOR  A
RET
;@ROUTINE OUT A,CARRY CLOBBERS HL,ZERO,SIGN,PARITY,HALFCARRY,BC,DE
EX_POPE2:
LD   A,(EX_ODEPT)
OR   A
JR   Z,EX_IFAIL
DEC  A
LD   (EX_ODEPT),A
CALL EX_OADR
LD   DE,EX_OPER
LD   BC,EX_OPERB
LDIR
XOR  A
RET
;@ROUTINE IN A OUT HL CLOBBERS DE,A,F
EX_OADR:
LD   E,A
LD   D,0
LD   H,D
LD   L,E
ADD  HL,HL
ADD  HL,HL
ADD  HL,DE
LD   DE,EX_OSTAC
ADD  HL,DE
RET
;@ROUTINE OUT A,CARRY CLOBBERS ZERO,SIGN,PARITY,HALFCARRY,DE,HL
EX_POPE3:
LD   A,(EX_ODEPT)
OR   A
SCF
RET  Z
DEC  A
CALL EX_OADR
LD   A,(HL)
OR   A
RET
;@ROUTINE OUT A,CARRY CLOBBERS HL,ZERO,SIGN,PARITY,HALFCARRY
EX_CFAIL:
LD   A,EX_SCAP
JP   EX_FHERE
;@ROUTINE OUT A,CARRY CLOBBERS HL,ZERO,SIGN,PARITY,HALFCARRY
EX_IFAIL:
LD   A,EX_SINT
JP   EX_FHERE
;@ROUTINE OUT CARRY,ZERO CLOBBERS BC,DE,HL,PARITY,HALFCARRY,SIGN,A
EX_SINCO:
LD   HL,EX_OPER
LD   DE,EX_INCOM
LD   BC,EX_OPERB
LDIR
RET
;@ROUTINE OUT CARRY,ZERO CLOBBERS BC,DE,HL,PARITY,HALFCARRY,SIGN,A
EX_RINCO:
LD   HL,EX_INCOM
LD   DE,EX_OPER
LD   BC,EX_OPERB
LDIR
RET
;@ROUTINE OUT A,CARRY CLOBBERS DE,HL,ZERO,SIGN,PARITY,HALFCARRY,BC,IX,IY
EX_RINC1:
.RILOOP:
CALL EX_POPE3
JR   C,.RIDONE
CP   EX_MLPAR
JR   Z,.RIDONE
LD   A,(EX_ODEPT)
DEC  A
CALL EX_OADR
INC  HL
LD   A,(EX_INCOM+1)
CP   (HL)
JR   C,.RINOW
JR   Z,.RINOW
RET
.RINOW:
CALL EX_REDUC
RET  C
JR   .RILOOP
.RIDONE:
XOR  A
RET
;@ROUTINE OUT A,CARRY CLOBBERS DE,HL,ZERO,SIGN,PARITY,HALFCARRY,BC,IX,IY
EX_RTPAR:
.RTPLOOP:
CALL EX_POPE3
JP   C,EX_IFAIL
CP   EX_MLPAR
RET  Z
CALL EX_REDUC
RET  C
JR   .RTPLOOP
;@ROUTINE OUT A,CARRY CLOBBERS BC,DE,HL,ZERO,SIGN,PARITY,HALFCARRY,IX,IY
EX_AUNAR:
.AULOOP:
CALL EX_POPE3
JR   C,.AUDONE
CP   EX_UPLUS
JR   C,.AUDONE
CALL EX_POPE2
RET  C
CALL EX_PVAL1
RET  C
LD   A,(EX_RUNRE)
OR   A
JR   Z,.AUCONCRE
LD   A,(EX_OPER)
CP   EX_UPLUS
JR   Z,.AUPUBLIS
CP   EX_ULO
JR   Z,.AUFLO
CP   EX_UHI
JR   Z,.AUFHI
.AUFFAIL:
LD   A,EX_SFFOR
JP   EX_FOPER
.AUFLO:
LD   B,EX_FLO
JR   .AUFFUNCT
.AUFHI:
LD   B,EX_FHI
.AUFFUNCT:
LD   A,(EX_RUNRE)
CP   EX_FPLAI
JR   NZ,.AUFFAIL
LD   A,B
LD   (EX_RUNRE),A
JR   .AUPUBLIS
.AUCONCRE:
LD   A,(EX_OPER)
CP   EX_UPLUS
JR   Z,.AUPUBLIS
CP   EX_UMINU
JR   Z,.AUNEGATE
CP   EX_UTILD
JR   Z,.AUCOMPLE
CP   EX_ULO
JR   Z,.AULO
CP   EX_UHI
JR   Z,.AUHI
JP   EX_IFAIL
.AUNEGATE:
CALL EX_NRES
JR   .AUCDONE
.AUCOMPLE:
CALL EX_CRES
JR   .AUCDONE
.AULO:
XOR  A
LD   (EX_RVAL+1),A
LD   (EX_RVAL+2),A
JR   .AUCDONE
.AUHI:
LD   A,(EX_RVAL+1)
LD   (EX_RVAL),A
XOR  A
LD   (EX_RVAL+1),A
LD   (EX_RVAL+2),A
.AUCDONE:
RET  C
.AUPUBLIS:
CALL EX_PVAL
RET  C
JR   .AULOOP
.AUDONE:
XOR  A
RET
;@ROUTINE OUT A,CARRY CLOBBERS DE,HL,ZERO,SIGN,PARITY,HALFCARRY,BC,IX,IY
EX_FSTAC:
.FREDUCE:
CALL EX_POPE3
JR   C,.FINVAL
CP   EX_MLPAR
JP   Z,EX_IFAIL
CALL EX_REDUC
RET  C
JR   .FREDUCE
.FINVAL:
CALL EX_PVAL1
RET  C
LD   A,(EX_VDEPT)
OR   A
JP   NZ,EX_IFAIL
RET
;@ROUTINE OUT A,CARRY CLOBBERS BC,DE,HL,ZERO,SIGN,PARITY,HALFCARRY,IX,IY
EX_REDUC:
CALL EX_POPE2
RET  C
CALL EX_PVAL1
RET  C
CALL EX_PLVAL
RET  C
CALL EX_RLOAD
RET  C
JP   EX_PVAL
;@ROUTINE OUT A,CARRY CLOBBERS BC,DE,HL,IX,IY,ZERO,SIGN,PARITY,HALFCARRY
EX_RLOAD:
LD   A,(EX_LUNRE)
LD   B,A
LD   A,(EX_RUNRE)
OR   B
JP   NZ,EX_RFORW
LD   A,(EX_OPER)
CP   EX_OPOR
JP   Z,EX_OR
CP   EX_OPXOR
JP   Z,EX_XOR
CP   EX_OPAND
JP   Z,EX_AND
CP   EX_OLEFT
JP   Z,EX_SLEFT
CP   EX_ORIGH
JP   Z,EX_SRIGH
CP   EX_OPADD
JP   Z,EX_ADD
CP   EX_OSUBT
JP   Z,EX_SUBTR
CP   EX_OMULT
JP   Z,EX_MULTI
CP   EX_ODIVI
JP   Z,EX_DIVID
CP   EX_OREMA
JP   Z,EX_REMAI
JP   EX_IFAIL
;@ROUTINE OUT A,CARRY CLOBBERS BC,DE,HL,IX,IY,ZERO,SIGN,PARITY,HALFCARRY
EX_RFORW:
LD   A,(EX_LUNRE)
CP   EX_FLO
JP   NC,.FFAIL
LD   A,(EX_RUNRE)
CP   EX_FLO
JP   NC,.FFAIL
LD   A,(EX_LUNRE)
OR   A
JR   Z,.FRIGHT
LD   A,(EX_RUNRE)
OR   A
JR   NZ,.FFAIL
LD   A,(EX_OPER)
CP   EX_OPADD
JR   Z,.FLADD
CP   EX_OSUBT
JR   NZ,.FFAIL
CALL EX_SUBTR
JR   C,.FRETURN
JR   .FULKEY
.FLADD:
CALL EX_ADD
JR   C,.FRETURN
.FULKEY:
LD   HL,EX_LKEY
LD   DE,EX_RKEY
LD   BC,6
LDIR
JR   .FFIN
.FRIGHT:
LD   A,(EX_OPER)
CP   EX_OPADD
JR   NZ,.FFAIL
CALL EX_ADD
JR   C,.FRETURN
.FFIN:
LD   A,EX_FPLAI
LD   (EX_RUNRE),A
CALL EX_RADDE
.FRETURN:
RET
.FFAIL:
LD   A,EX_SFFOR
JP   EX_FOPER
;@ROUTINE OUT A,CARRY CLOBBERS BC,HL,SIGN,PARITY,HALFCARRY,DE,ZERO
EX_ADD:
LD   A,(EX_LVAL+2)
LD   B,A
LD   A,(EX_RVAL+2)
LD   C,A
LD   A,(EX_LVAL)
LD   HL,EX_RVAL
ADD  A,(HL)
LD   (HL),A
INC  HL
LD   A,(EX_LVAL+1)
ADC  A,(HL)
LD   (HL),A
INC  HL
LD   A,B
ADC  A,(HL)
LD   (HL),A
LD   D,A
LD   A,B
XOR  C
BIT  7,A
JP   NZ,EX_AOK
LD   A,B
XOR  D
BIT  7,A
JP   NZ,EX_ROPER
;@ROUTINE OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY
EX_AOK:
XOR  A
RET
;@ROUTINE OUT A,CARRY CLOBBERS BC,HL,SIGN,PARITY,HALFCARRY,DE,ZERO,IX,IY
EX_SUBTR:
LD   A,(EX_LVAL+2)
LD   B,A
LD   A,(EX_RVAL+2)
LD   C,A
LD   A,(EX_LVAL)
LD   HL,EX_RVAL
SUB  (HL)
LD   (HL),A
INC  HL
LD   A,(EX_LVAL+1)
SBC  A,(HL)
LD   (HL),A
INC  HL
LD   A,B
SBC  A,(HL)
LD   (HL),A
LD   D,A
LD   A,B
XOR  C
BIT  7,A
JP   Z,EX_AOK
LD   A,B
XOR  D
BIT  7,A
JP   NZ,EX_ROPER
JP   EX_AOK
;@ROUTINE OUT A,CARRY CLOBBERS BC,DE,HL,SIGN,PARITY,HALFCARRY,ZERO
EX_AND:
LD   HL,EX_RVAL
LD   DE,EX_LVAL
LD   B,3
.ANDLOOP:
LD   A,(DE)
AND  (HL)
LD   (HL),A
INC  DE
INC  HL
DJNZ .ANDLOOP
XOR  A
RET
;@ROUTINE OUT A,CARRY CLOBBERS BC,DE,HL,SIGN,PARITY,HALFCARRY,ZERO
EX_XOR:
LD   HL,EX_RVAL
LD   DE,EX_LVAL
LD   B,3
.XORLOOP:
LD   A,(DE)
XOR  (HL)
LD   (HL),A
INC  DE
INC  HL
DJNZ .XORLOOP
XOR  A
RET
;@ROUTINE OUT A,CARRY CLOBBERS BC,DE,HL,SIGN,PARITY,HALFCARRY,ZERO
EX_OR:
LD   HL,EX_RVAL
LD   DE,EX_LVAL
LD   B,3
.ORLOOP:
LD   A,(DE)
OR   (HL)
LD   (HL),A
INC  DE
INC  HL
DJNZ .ORLOOP
XOR  A
RET
;@ROUTINE OUT A,CARRY CLOBBERS HL,ZERO,SIGN,PARITY,HALFCARRY,BC,DE,IX,IY
EX_SLEFT:
CALL EX_SCNT
RET  C
LD   B,A
OR   A
JR   Z,.SLCOPY
.SLLOOP:
LD   A,(EX_LVAL+2)
LD   C,A
LD   HL,EX_LVAL
LD   A,(HL)
SLA  A
LD   (HL),A
INC  HL
LD   A,(HL)
RL   A
LD   (HL),A
INC  HL
LD   A,(HL)
RL   A
LD   (HL),A
LD   A,(HL)
XOR  C
BIT  7,A
JP   NZ,EX_ROPER
DJNZ .SLLOOP
.SLCOPY:
LD   HL,EX_LVAL
LD   DE,EX_RVAL
LD   BC,3
LDIR
XOR  A
RET
;@ROUTINE OUT A,CARRY CLOBBERS HL,ZERO,SIGN,PARITY,HALFCARRY,BC,DE,IX,IY
EX_SRIGH:
CALL EX_SCNT
RET  C
LD   (EX_SCOUN),A
LD   HL,EX_LVAL
LD   DE,EX_RVAL
LD   BC,3
LDIR
LD   A,(EX_SCOUN)
OR   A
JP   Z,EX_AOK
LD   B,A
.SRLOOP:
LD   HL,EX_RVAL+2
LD   A,(HL)
SRA  A
LD   (HL),A
DEC  HL
LD   A,(HL)
RR   A
LD   (HL),A
DEC  HL
LD   A,(HL)
RR   A
LD   (HL),A
DJNZ .SRLOOP
XOR  A
RET
;@ROUTINE OUT A,CARRY CLOBBERS HL,ZERO,SIGN,PARITY,HALFCARRY
EX_SCNT:
LD   A,(EX_RVAL+2)
OR   A
JP   NZ,EX_ROPER
LD   A,(EX_RVAL+1)
OR   A
JP   NZ,EX_ROPER
LD   A,(EX_RVAL)
CP   24
JP   NC,EX_ROPER
OR   A
RET
;@ROUTINE OUT A,CARRY CLOBBERS BC,DE,HL,IX,IY,ZERO,SIGN,PARITY,HALFCARRY
EX_MULTI:
CALL EX_PMAGN
XOR  A
LD   (EX_ACCUM),A
LD   (EX_ACCUM+1),A
LD   (EX_ACCUM+2),A
LD   A,24
LD   (EX_MCOUN),A
.MLOOP:
LD   A,(EX_MRIGH)
BIT  0,A
JR   Z,.MSADD
CALL EX_AALEF
JP   C,EX_ROPER
.MSADD:
CALL EX_MRSHI
LD   A,(EX_MRIGH)
LD   C,A
LD   A,(EX_MRIGH+1)
OR   C
LD   C,A
LD   A,(EX_MRIGH+2)
OR   C
JR   Z,.MDONE
LD   A,(EX_MLEFT+2)
BIT  7,A
JP   NZ,EX_ROPER
CALL EX_MLSHI
LD   HL,EX_MCOUN
DEC  (HL)
JR   NZ,.MLOOP
.MDONE:
LD   HL,EX_ACCUM
LD   DE,EX_RVAL
LD   BC,3
LDIR
LD   A,(EX_SRES)
OR   A
CALL NZ,EX_NRES
RET  C
XOR  A
RET
;@ROUTINE OUT A,CARRY CLOBBERS BC,DE,HL,IX,IY,ZERO,SIGN,PARITY,HALFCARRY
EX_DIVID:
XOR  A
LD   (EX_DRMOD),A
JR   EX_DCOMM
;@ROUTINE OUT A,CARRY CLOBBERS BC,DE,HL,ZERO,SIGN,PARITY,HALFCARRY
EX_REMAI:
LD   A,1
LD   (EX_DRMOD),A
;@ROUTINE OUT A,CARRY CLOBBERS BC,DE,HL,IX,IY,SIGN,PARITY,HALFCARRY,ZERO
EX_DCOMM:
LD   A,(EX_RVAL)
LD   B,A
LD   A,(EX_RVAL+1)
OR   B
LD   B,A
LD   A,(EX_RVAL+2)
OR   B
JR   Z,.DZERO
CALL EX_PMAGN
XOR  A
LD   (EX_ACCUM),A
LD   (EX_ACCUM+1),A
LD   (EX_ACCUM+2),A
LD   (EX_QUOTI),A
LD   (EX_QUOTI+1),A
LD   (EX_QUOTI+2),A
LD   B,24
.DLOOP:
LD   HL,EX_MLEFT
LD   A,(HL)
SLA  A
LD   (HL),A
INC  HL
LD   A,(HL)
RL   A
LD   (HL),A
INC  HL
LD   A,(HL)
RL   A
LD   (HL),A
