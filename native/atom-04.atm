;@ROUTINE OUT A,CARRY CLOBBERS BC,DE,HL,IX,ZERO,SIGN,PARITY,HALFCARRY,IY
PR_PREF:
LD   A,(PR_RSCAN)
CALL PR_BRADR
LD   HL,PR_BPART
ADD  HL,DE
LD   A,(HL)
CP   16
JP   NC,.RPFAIL
LD   A,(PR_RSCAN)
CALL PR_BRADR
LD   H,D
LD   L,E
CALL SY_FIND
RET  NC
CP   SY_SNFOU
JR   NZ,.PSFAIL
LD   HL,PR_RMCNT
INC  (HL)
XOR  A
RET
.PSFAIL:
LD   (PR_SSTAT),A
LD   A,PR_SSYM
JP   PR_FREF
.RPFAIL:
LD   A,PR_SPCAP
JP   PR_FREF
;@ROUTINE OUT A,CARRY CLOBBERS DE,HL,ZERO,SIGN,PARITY,HALFCARRY,B
PR_CRKEY:
LD   HL,PR_RBLD
LD   DE,PR_RBLD+PR_BRB
LD   B,6
.CRKLOOP:
LD   A,(DE)
CP   (HL)
SCF
RET  NZ
INC  DE
INC  HL
DJNZ .CRKLOOP
OR   A
RET
PR_SCFAI:
LD   A,SY_SSCAP
LD   (PR_SSTAT),A
LD   A,PR_SSYM
JP   PR_FREF
PR_USFAI:
LD   (PR_SSTAT),A
LD   A,PR_SINT
JP   PR_FREF
;@ROUTINE IN A OUT HL CLOBBERS DE,A,F
PR_PRADR:
LD   HL,PR_REFER
OR   A
RET  Z
LD   DE,PR_PRB
ADD  HL,DE
RET
;@ROUTINE OUT A,CARRY CLOBBERS BC,DE,HL,SIGN,PARITY,HALFCARRY,ZERO,IX
PR_CREFE:
LD   A,(PR_RCNT)
LD   B,A
ADD  A,A
ADD  A,B
ADD  A,A
LD   B,A
LD   HL,(SY_AEND1)
LD   DE,(SY_NEXT)
OR   A
SBC  HL,DE
JR   C,PR_QCAP
LD   A,H
OR   A
JR   NZ,.QCSYMBOL
LD   A,L
CP   B
JR   C,PR_QCAP
.QCSYMBOL:
XOR  A
LD   (PR_RSCAN),A
.QCLOOP:
LD   A,(PR_RCNT)
LD   B,A
LD   A,(PR_RSCAN)
CP   B
JR   Z,.QPDONE
CALL PR_PRADR
LD   E,(HL)
INC  HL
LD   D,(HL)
EX   DE,HL
LD   DE,5
ADD  HL,DE
BIT  6,(HL)
JR   NZ,PR_QADEF
LD   HL,PR_RSCAN
INC  (HL)
JR   .QCLOOP
.QPDONE:
XOR  A
RET
;@ROUTINE IN DE OUT A,CARRY CLOBBERS BC,DE,HL,IX,ZERO,SIGN,PARITY,HALFCARRY
PR_QREFE:
LD   (PR_QBASE),DE
CALL PR_CREFE
RET  C
.QUEUECMT:
XOR  A
LD   (PR_RSCAN),A
.QLOOP:
LD   A,(PR_RCNT)
LD   B,A
LD   A,(PR_RSCAN)
CP   B
JR   Z,.QDONE
CALL PR_PRADR
LD   E,(HL)
INC  HL
LD   D,(HL)
PUSH DE
POP  IX
INC  HL
LD   C,(HL)
INC  HL
INC  HL
LD   B,(HL)
INC  HL
LD   A,(HL)
LD   HL,(PR_QBASE)
LD   E,A
LD   D,0
ADD  HL,DE
EX   DE,HL
CALL SY_ADD
RET  C
LD   HL,PR_RSCAN
INC  (HL)
JR   .QLOOP
.QDONE:
XOR  A
RET
PR_QCAP:
LD   A,SY_SPCAP
SCF
RET
PR_QADEF:
LD   A,SY_SADEF
SCF
RET
PR_FESYM:
LD   (PR_ESTAT),A
LD   A,(EX_SPART)
LD   (PR_EPART),A
LD   HL,(EX_SOFF)
LD   (PR_EOFF),HL
LD   A,(PR_ESTAT)
SCF
RET
PR_FREF:
LD   (PR_ESTAT),A
LD   A,(PR_RSCAN)
CALL PR_BRADR
LD   HL,PR_BPART
ADD  HL,DE
LD   A,(HL)
LD   (PR_EPART),A
INC  HL
LD   E,(HL)
INC  HL
LD   D,(HL)
LD   (PR_EOFF),DE
LD   A,(PR_ESTAT)
SCF
RET
;@ROUTINE OUT A,IX,CARRY CLOBBERS BC,DE,HL,SIGN,PARITY,HALFCARRY,ZERO
PR_CMT:
LD   HL,PR_SCRAT
LD   DE,(PR_DST)
LD   BC,10
LDIR
LD   IX,(PR_DST)
XOR  A
RET
PR_EMNEM:
LD   A,PR_SEMNE
JP   PR_FHERE
PR_UMNEM:
LD   A,PR_SUMNE
JP   PR_FHERE
PR_EXPOP:
LD   A,PR_SEOP
JP   PR_FHERE
PR_UOP:
LD   A,PR_SUOP
JP   PR_FHERE
PR_EDELI:
LD   A,PR_SEDEL
JP   PR_FHERE
PR_TMOPE:
LD   A,PR_STMOP
JP   PR_FHERE
PR_VRANG:
LD   A,PR_SVRAN
JP   PR_FHERE
PR_RRANG:
LD   A,PR_SRRAN
JP   PR_FBEG
;@ROUTINE IN A OUT A,CARRY CLOBBERS HL,HALFCARRY,ZERO,SIGN,PARITY
PR_FHERE:
LD   (PR_ESTAT),A
LD   A,(TK_REC+TK_POFF)
LD   (PR_EPART),A
LD   HL,(TK_REC+TK_SOFF)
LD   (PR_EOFF),HL
LD   A,(PR_ESTAT)
SCF
RET
;@ROUTINE IN A OUT A,CARRY CLOBBERS HL,HALFCARRY,ZERO,SIGN,PARITY
PR_FBEG:
LD   (PR_ESTAT),A
LD   A,(PR_IPART)
LD   (PR_EPART),A
LD   HL,(PR_IOFF)
LD   (PR_EOFF),HL
LD   A,(PR_ESTAT)
SCF
RET
PR_RCEND:
PR_IBEG:
PR_OWCNT EQU 27
PR_OWTAB:
DW  $0640
DB  EN_A
DW  $0730
DB  EN_AF
DW  $0C80
DB  EN_B
DW  $0CF8
DB  EN_BC
DW  $12C0
DB  PR_GC
DW  $1900
DB  EN_D
DW  $19C8
DB  EN_DE
DW  $1F40
DB  EN_E
DW  $3200
DB  EN_H
DW  $33E0
DB  EN_HL
DW  $3840
DB  EN_I
DW  $3C00
DB  EN_IX
DW  $3C08
DB  EN_IXH
DW  $3C0C
DB  EN_IXL
DW  $3C28
DB  EN_IY
DW  $3C30
DB  EN_IYH
DW  $3C34
DB  EN_IYL
DW  $4B00
DB  EN_L
DW  $5140
DB  EN_M
DW  $57F8
DB  EN_NC
DW  $5B90
DB  EN_NZ
DW  $6400
DB  EN_P
DW  $64C8
DB  EN_PE
DW  $6658
DB  EN_PO
DW  $7080
DB  EN_R
DW  $7940
DB  EN_SP
DW  $A280
DB  EN_Z
PR_OWTEN:
PR_IEND:
PR_CEND:
PR_WBEG:
PR_DST: DW 0
PR_IADR: DW 0
PR_IPART: DB 0
PR_IOFF: DW 0
PR_ILEN: DB 0
PR_OPCNT: DB 0
PR_SINDE: DB 0
PR_FMASK: DB 0
PR_CMASK: DB 0
PR_CPTR: DW 0
PR_VPTR: DW 0
PR_LCLAS: DB 0
PR_MBASE: DB 0
PR_ICLAS: DB 0
PR_DSIGN: DB 0
PR_NKEY: DS 6
PR_ESTAT: DB 0
PR_EPART: DB 0
PR_EOFF: DW 0
PR_SCRAT: DS 10
PR_ESTA1: DB 0
PR_SSTAT: DB 0
PR_RCNT: DB 0
PR_RBCNT: DB 0
PR_UMASK: DB 0
PR_RSCAN: DB 0
PR_RMCNT: DB 0
PR_RSKEY: DB 0
PR_RKSCR: DB 0
PR_ROSCR: DB 0
PR_RASCR: DW 0
PR_QBASE: DW 0
PR_RBLD: DS PR_BRB*PR_RCAP
PR_REFER: DS PR_PRB*PR_RCAP
PR_WEND:
OU_CBEG:
OU_SCAP EQU 1
OU_SINT EQU 2
OU_SVRAN EQU 3
OU_SRRAN EQU 4
;@ROUTINE IN DE,HL OUT A,CARRY CLOBBERS SIGN,PARITY,HALFCARRY,ZERO
OU_RESET:
LD   (OU_CURSO),HL
LD   (OU_REM),DE
XOR  A
RET
;@ROUTINE IN HL OUT A,CARRY CLOBBERS DE,SIGN,PARITY,HALFCARRY,HL,ZERO
OU_CCAP:
EX   DE,HL
LD   HL,(OU_REM)
OR   A
SBC  HL,DE
JR   C,OU_DCFAI
XOR  A
RET
;@ROUTINE IN A OUT A,CARRY CLOBBERS DE,HL,ZERO,SIGN,PARITY,HALFCARRY,BC,IX,IY
OU_EMITB:
LD   (OU_DVAL),A
LD   HL,1
CALL OU_CCAP
RET  C
LD   A,(OU_DVAL)
JP   OU_EBREA
;@ROUTINE IN HL OUT A,CARRY CLOBBERS DE,HL,ZERO,SIGN,PARITY,HALFCARRY,BC,IX,IY
OU_EMITW:
LD   (OU_DVAL),HL
LD   HL,2
CALL OU_CCAP
RET  C
LD   A,(OU_DVAL)
CALL OU_EBREA
RET  C
LD   A,(OU_DVAL+1)
JP   OU_EBREA
;@ROUTINE IN HL OUT A,CARRY CLOBBERS DE,HL,ZERO,SIGN,PARITY,HALFCARRY
OU_RESER:
LD   (OU_DVAL),HL
CALL OU_CCAP
RET  C
LD   DE,(OU_DVAL)
LD   HL,(OU_CURSO)
ADD  HL,DE
LD   (OU_CURSO),HL
LD   HL,(OU_REM)
OR   A
SBC  HL,DE
LD   (OU_REM),HL
XOR  A
RET
;@ROUTINE IN HL OUT A,CARRY CLOBBERS SIGN,PARITY,HALFCARRY,ZERO
OU_SORIG:
LD   (OU_CURSO),HL
XOR  A
RET
;@ROUTINE IN A OUT A,CARRY CLOBBERS BC,HL,ZERO,SIGN,PARITY,HALFCARRY,DE,IX,IY
OU_EBREA:
LD   HL,(OU_CURSO)
LD   C,0
CALL HS_IB
RET  C
LD   HL,(OU_CURSO)
INC  HL
LD   (OU_CURSO),HL
LD   HL,(OU_REM)
DEC  HL
LD   (OU_REM),HL
XOR  A
RET
OU_DCFAI:
LD   A,OU_SCAP
SCF
RET
;@ROUTINE IN IX OUT A,CARRY CLOBBERS BC,DE,HL,ZERO,SIGN,PARITY,HALFCARRY,IX,IY
OU_EINS:
LD   HL,(OU_CURSO)
LD   (OU_IBEG),HL
LD   DE,OU_INSB
CALL EN_NAME
RET  C
LD   (OU_ILEN),A
LD   B,A
LD   HL,(OU_REM)
LD   A,H
OR   A
JR   NZ,.ICREADY
LD   A,L
CP   B
JR   C,.ICFAIL
.ICREADY:
CALL PR_CREFE
RET  C
XOR  A
LD   (OU_ISCAN),A
.INSLOOP:
LD   A,(OU_ILEN)
LD   B,A
LD   A,(OU_ISCAN)
CP   B
JR   Z,.INSDONE
LD   E,A
LD   D,0
LD   HL,OU_INSB
ADD  HL,DE
LD   A,(HL)
LD   HL,(OU_CURSO)
LD   C,0
CALL HS_IB
RET  C
LD   HL,(OU_CURSO)
INC  HL
LD   (OU_CURSO),HL
LD   HL,(OU_REM)
DEC  HL
LD   (OU_REM),HL
LD   HL,OU_ISCAN
INC  (HL)
JR   .INSLOOP
.INSDONE:
LD   DE,(OU_IBEG)
CALL PR_QREFE
RET
.ICFAIL:
LD   A,OU_SCAP
SCF
RET
;@ROUTINE IN IX OUT A,CARRY CLOBBERS BC,DE,HL,IX,IY,ZERO,SIGN,PARITY,HALFCARRY
OU_RSLV:
BIT  6,(IX+5)
JP   Z,OU_RINT
PUSH IX
POP  HL
LD   (OU_RSPTR),HL
.RSLVLOOP:
LD   IX,(OU_RSPTR)
;@EXPECTOUT A,CARRY,BC,DE
CALL SY_PEEK
JP   C,.RPFAIL
LD   (OU_RPADR),DE
LD   A,B
AND  SY_KMASK
LD   (OU_RKIND),A
LD   A,C
LD   (OU_RADDE),A
LD   IX,(OU_RSPTR)
LD   L,(IX+SY_VALLO)
LD   H,(IX+SY_VALHI)
XOR  A
BIT  5,(IX+5)
JR   Z,.RBREADY
DEC  A
.RBREADY:
LD   (OU_RBHI),A
LD   A,(OU_RADDE)
LD   C,A
LD   D,0
BIT  7,C
JR   Z,.RSREADY
DEC  D
.RSREADY:
LD   A,L
ADD  A,C
LD   (OU_RVAL),A
LD   A,H
ADC  A,D
LD   (OU_RVAL+1),A
LD   A,(OU_RBHI)
ADC  A,D
LD   (OU_RVAL+2),A
CALL OU_RWDOM
RET  C
LD   A,(OU_RKIND)
CP   PT_KINDB
JR   Z,.RSLVB
CP   PT_KINDW
JR   Z,.RSLVW
CP   PT_KRELA
JR   Z,.RRELATIV
CP   PT_KDISP
JR   Z,.RDISPLAC
CP   PT_KTB
JR   Z,.RSB
CP   PT_KLB
JR   Z,.RSB
CP   PT_KHB
JR   Z,.RSLVHIB
JP   OU_RINT
.RSLVHIB:
LD   A,(OU_RVAL+1)
JR   .RSBA
.RSLVB:
LD   A,(OU_RVAL+2)
OR   A
JR   NZ,OU_RVRAN
LD   A,(OU_RVAL+1)
OR   A
JR   NZ,OU_RVRAN
JR   .RSB
.RDISPLAC:
LD   A,(OU_RVAL+2)
OR   A
JR   Z,.RDPOSITI
INC  A
JR   NZ,OU_RVRAN
LD   A,(OU_RVAL+1)
INC  A
JR   NZ,OU_RVRAN
LD   A,(OU_RVAL)
BIT  7,A
JR   Z,OU_RVRAN
JR   .RSB
.RDPOSITI:
LD   A,(OU_RVAL+1)
OR   A
JR   NZ,OU_RVRAN
LD   A,(OU_RVAL)
BIT  7,A
JR   NZ,OU_RVRAN
JR   .RSB
.RRELATIV:
LD   HL,(OU_RVAL)
LD   DE,(OU_RPADR)
INC  DE
OR   A
SBC  HL,DE
LD   A,H
OR   A
JR   Z,.RRPOSITI
INC  A
JR   NZ,OU_RRRAN
BIT  7,L
JR   Z,OU_RRRAN
LD   A,L
JR   .RSBA
.RRPOSITI:
BIT  7,L
JR   NZ,OU_RRRAN
LD   A,L
JR   .RSBA
.RSB:
LD   A,(OU_RVAL)
.RSBA:
LD   HL,(OU_RPADR)
LD   C,0
CALL HS_PB
RET  C
JR   .RREMOVE
.RSLVW:
LD   HL,(OU_RVAL)
LD   DE,(OU_RPADR)
LD   C,0
CALL HS_PW
RET  C
.RREMOVE:
LD   IX,(OU_RSPTR)
CALL SY_TAKE
JR   C,OU_RINT
JP   .RSLVLOOP
.RPFAIL:
CP   SY_SNFOU
RET  NZ
XOR  A
RET
OU_RVRAN:
LD   A,OU_SVRAN
SCF
RET
OU_RRRAN:
LD   A,OU_SRRAN
SCF
RET
OU_RINT:
LD   A,OU_SINT
SCF
RET
;@ROUTINE OUT A,CARRY CLOBBERS ZERO,SIGN,PARITY,HALFCARRY,BC,DE,HL,IX,IY
OU_RWDOM:
LD   A,(OU_RVAL+2)
OR   A
RET  Z
INC  A
JR   NZ,OU_RVRAN
LD   A,(OU_RVAL+1)
BIT  7,A
RET  NZ
JR   OU_RVRAN
OU_CEND:
OU_WBEG:
OU_CURSO: DW 0
OU_REM: DW 0
OU_IBEG: DW 0
OU_INSB: DS 4
OU_ILEN: DB 0
OU_ISCAN: DB 0
OU_RSPTR: DW 0
OU_RPADR: DW 0
OU_RKIND: DB 0
OU_RADDE: DB 0
OU_RVAL: DS 3
OU_DVAL: DW 0
OU_RBHI: DB 0
OU_WEND:
ST_CBEG:
ST_SOK EQU 0
ST_SLEXI EQU 1
ST_SEXP EQU 2
ST_SDIR EQU 3
ST_SEQUA EQU 4
ST_SSYM EQU 5
ST_SINS EQU 6
ST_SOUT EQU 7
ST_SUNDE EQU 8
ST_SINT EQU 9
ST_EQU EQU 1
ST_ORG EQU 2
ST_DB EQU 3
ST_DW EQU 4
ST_DS EQU 5
ST_CSTR EQU 6
ST_PSTR EQU 7
ST_ISTR EQU 8
ST_ALIGN EQU 9
ST_CNT EQU 9
;@ROUTINE OUT A,CARRY CLOBBERS BC,DE,HL,IX,IY,ZERO,SIGN,PARITY,HALFCARRY
DR_APART:
ST_NEXT:
CALL TK_NEXT
JP   C,ST_LFAIL
LD   A,(TK_REC+TK_KOFF)
CP   TK_EOF
JP   Z,ST_SUCCE
CP   TK_EOL
JP   Z,ST_NEXT
CP   TK_NAME
JP   NZ,ST_EHERE
CALL ST_CPOSI
LD   HL,(TK_REC+TK_LOFF)
LD   A,(TK_REC+TK_LOFF1)
LD   B,A
LD   DE,ST_KEY
CALL EN_PSYM
JP   C,ST_SFAIL
LD   HL,(TK_REC+TK_LOFF)
LD   A,(TK_REC+TK_LOFF1)
LD   B,A
CALL EN_RECOG
JR   C,ST_NMNEM
LD   (ST_MNEM),A
LD   A,1
LD   (ST_MVALI),A
XOR  A
LD   (ST_DVALI),A
JR   ST_AFNAM
ST_NMNEM:
XOR  A
LD   (ST_MVALI),A
LD   HL,(TK_REC+TK_LOFF)
LD   A,(TK_REC+TK_LOFF1)
LD   B,A
CALL EN_RDIR
JR   C,ST_NDIR
LD   (ST_DIR),A
LD   A,1
LD   (ST_DVALI),A
JR   ST_AFNAM
ST_NDIR:
XOR  A
LD   (ST_DVALI),A
ST_AFNAM:
CALL TK_NEXT
JP   C,ST_LFAIL
LD   A,(TK_REC+TK_KOFF)
CP   TK_COLON
JR   Z,ST_LABEL
LD   A,(ST_MVALI)
OR   A
JP   NZ,ST_IPUB
LD   A,(ST_DVALI)
OR   A
JR   Z,ST_TEQUA
LD   A,(ST_DIR)
JP   ST_DPUB
ST_TEQUA:
LD   A,(TK_REC+TK_KOFF)
CP   TK_NAME
JP   NZ,ST_ESAVE
LD   HL,(TK_REC+TK_LOFF)
LD   A,(TK_REC+TK_LOFF1)
LD   B,A
CALL EN_RDIR
JP   C,ST_ESAVE
CP   ST_EQU
JP   NZ,ST_ESAVE
JP   ST_EQUAT
ST_LABEL:
CALL TK_NEXT
JP   C,ST_LFAIL
LD   A,(TK_REC+TK_KOFF)
CP   TK_NAME
JR   NZ,ST_LPUBL
LD   HL,(TK_REC+TK_LOFF)
LD   A,(TK_REC+TK_LOFF1)
LD   B,A
CALL EN_RDIR
JR   C,ST_LPUBL
CP   ST_EQU
JP   Z,ST_EQUAT
ST_LPUBL:
LD   HL,ST_KEY+5
BIT  7,(HL)
LD   HL,ST_KEY
LD   DE,(OU_CURSO)
JR   NZ,ST_PLABE
CALL SY_DGLAB
JR   ST_LDECL
ST_PLABE:
CALL SY_DECL
ST_LDECL:
JP   C,ST_SFAIL
CALL OU_RSLV
JP   C,ST_OFAIL
LD   A,(TK_REC+TK_KOFF)
CP   TK_EOL
JP   Z,ST_NEXT
CP   TK_NAME
JP   NZ,ST_EHERE
CALL ST_CPOSI
LD   HL,(TK_REC+TK_LOFF)
LD   A,(TK_REC+TK_LOFF1)
LD   B,A
CALL EN_RECOG
JR   C,ST_LDIR
LD   (ST_MNEM),A
CALL TK_NEXT
JP   C,ST_LFAIL
JR   ST_IPUB
ST_LDIR:
LD   HL,(TK_REC+TK_LOFF)
LD   A,(TK_REC+TK_LOFF1)
LD   B,A
CALL EN_RDIR
JP   C,ST_ESAVE
LD   (ST_DIR),A
CALL TK_NEXT
JP   C,ST_LFAIL
LD   A,(ST_DIR)
JP   ST_DPUB
ST_IPUB:
LD   A,(ST_MNEM)
LD   BC,(OU_CURSO)
LD   DE,ST_INS
CALL PR_PUB
JP   C,ST_IFAIL
CALL OU_EINS
JP   C,ST_OFAIL
JP   ST_NEXT
ST_EQUAT:
CALL TK_NEXT
JP   C,ST_LFAIL
LD   BC,(OU_CURSO)
CALL EX_PDEFR
JP   C,ST_EFAIL
OR   A
JP   NZ,ST_EUNRE
LD   (ST_EVAL),HL
XOR  A
LD   HL,EX_RVAL+2
CP   (HL)
JR   Z,ST_ESREA
INC  A
ST_ESREA:
LD   (ST_ESIGN),A
LD   A,(TK_REC+TK_KOFF)
CP   TK_EOL
JP   NZ,ST_EDELI
LD   HL,ST_KEY
LD   DE,(ST_EVAL)
CALL SY_DECL
JP   C,ST_SFAIL
LD   A,(ST_ESIGN)
OR   A
JR   Z,ST_ERSLV
SET  5,(IX+5)
ST_ERSLV:
CALL OU_RSLV
JP   C,ST_OFAIL
JP   ST_NEXT
ST_DPUB:
CP   ST_ORG
JR   Z,ST_ORG1
CP   ST_DB
JR   Z,ST_DB1
CP   ST_DW
JR   Z,ST_DW1
CP   ST_DS
JP   Z,ST_DS1
CP   ST_CSTR
JP   Z,ST_CSTR1
CP   ST_PSTR
JP   Z,ST_PSTR1
CP   ST_ISTR
JP   Z,ST_ISTR1
CP   ST_ALIGN
JP   Z,ST_ALIG1
JP   ST_ESAVE
ST_ORG1:
LD   BC,(OU_CURSO)
CALL EX_PDEFR
JP   C,ST_DFAIL
OR   A
JP   NZ,ST_DUNR1
LD   (ST_DVAL),HL
LD   A,(TK_REC+TK_KOFF)
CP   TK_EOL
JP   NZ,ST_DDEL1
LD   HL,(ST_DVAL)
CALL OU_SORIG
JP   C,ST_OFAIL
JP   ST_NEXT
ST_DB1:
LD   A,1
LD   (ST_DWIDT),A
LD   A,PT_KTB
LD   (ST_DPKIN),A
JR   ST_DITEM
ST_DW1:
LD   A,2
LD   (ST_DWIDT),A
LD   A,PT_KINDW
LD   (ST_DPKIN),A
ST_DITEM:
LD   A,(TK_REC+TK_KOFF)
CP   TK_EOL
JP   Z,ST_DEXP
CP   TK_STRIN
JR   NZ,ST_DEXPR
LD   A,(ST_DWIDT)
CP   1
JP   NZ,ST_DSTR1
XOR  A
LD   (ST_SMODE),A
JP   ST_DSTRI
ST_DEXPR:
LD   BC,(OU_CURSO)
CALL EX_PDEFR
JP   C,ST_DFAIL
OR   A
JR   NZ,ST_DUNRE
LD   A,(ST_DWIDT)
CP   1
JR   Z,ST_DRB
CALL OU_EMITW
JP   C,ST_OFAIL
JP   ST_DDELI
ST_DRB:
LD   A,L
CALL OU_EMITB
JP   C,ST_OFAIL
JP   ST_DDELI
ST_DUNRE:
LD   A,L
LD   (ST_DADDE),A
PUSH IX
POP  HL
LD   (ST_DKEY),HL
LD   A,(ST_DWIDT)
LD   L,A
LD   H,0
CALL OU_CCAP
JP   C,ST_OFAIL
CALL SY_CCAP
JP   C,ST_SFAIL
LD   A,(EX_RUNRE)
CP   EX_FLO
JR   Z,ST_DPLO
CP   EX_FHI
JR   Z,ST_DPHI
LD   A,(ST_DPKIN)
JR   ST_DPKRE
ST_DPLO:
LD   A,PT_KLB
JR   ST_DPKRE
ST_DPHI:
LD   A,PT_KHB
ST_DPKRE:
LD   (ST_DPKI1),A
LD   A,(EX_SPART)
CP   16
JP   NC,ST_SPFAI
LD   HL,(ST_DKEY)
CALL SY_REF
JP   C,ST_SFAIL
LD   A,B
OR   A
JR   Z,ST_DDREA
LD   HL,(EX_SOFF)
LD   (IX+SY_VALLO),L
LD   (IX+SY_VALHI),H
LD   A,(EX_SPART)
ADD  A,A
ADD  A,A
ADD  A,A
OR   SY_DANCH
LD   HL,ST_DPKI1
OR   (HL)
LD   (HL),A
ST_DDREA:
PUSH IX
POP  HL
LD   (ST_DSYM),HL
LD   HL,(OU_CURSO)
LD   (ST_DADR),HL
LD   A,(ST_DWIDT)
CP   1
JR   Z,ST_DPB
LD   HL,0
CALL OU_EMITW
JP   C,ST_OFAIL
JR   ST_DQUEU
ST_DPB:
XOR  A
CALL OU_EMITB
JP   C,ST_OFAIL
ST_DQUEU:
LD   IX,(ST_DSYM)
LD   DE,(ST_DADR)
LD   A,(ST_DPKI1)
LD   B,A
LD   A,(ST_DADDE)
LD   C,A
CALL SY_ADD
JP   C,ST_SFAIL
ST_DDELI:
LD   A,(TK_REC+TK_KOFF)
CP   TK_EOL
JP   Z,ST_NEXT
CP   TK_COMMA
JP   NZ,ST_DDEL1
CALL TK_NEXT
JP   C,ST_LFAIL
LD   A,(TK_REC+TK_KOFF)
CP   TK_EOL
JP   Z,ST_DEXP
JP   ST_DITEM
ST_DSTRI:
LD   HL,(TK_REC+TK_LOFF)
INC  HL
LD   A,(TK_REC+TK_LOFF1)
SUB  2
LD   B,A
LD   C,0
ST_SCLOO:
LD   A,B
OR   A
JR   Z,ST_SCDON
LD   A,(HL)
INC  HL
DEC  B
CP   $5C
JR   NZ,ST_SCONE
LD   A,(HL)
INC  HL
DEC  B
CP   $78
JR   NZ,ST_SCONE
INC  HL
INC  HL
DEC  B
DEC  B
ST_SCONE:
INC  C
JR   ST_SCLOO
ST_SCDON:
LD   A,C
LD   (ST_SCNT),A
LD   HL,(TK_REC+TK_LOFF)
INC  HL
LD   (ST_SPTR),HL
LD   A,(TK_REC+TK_LOFF1)
SUB  2
LD   (ST_SREM),A
LD   A,(ST_SMODE)
OR   A
JR   Z,ST_SCAP
CALL TK_NEXT
JP   C,ST_LFAIL
LD   A,(TK_REC+TK_KOFF)
CP   TK_EOL
JP   NZ,ST_DDEL1
ST_SCAP:
LD   A,(ST_SCNT)
LD   L,A
LD   H,0
LD   A,(ST_SMODE)
CP   1
JR   Z,ST_SCEXT
CP   2
JR   NZ,ST_SCREA
ST_SCEXT:
INC  HL
ST_SCREA:
CALL OU_CCAP
JP   C,ST_OFAIL
LD   A,(ST_SMODE)
CP   2
JR   NZ,ST_SELOO
LD   A,(ST_SCNT)
CALL OU_EMITB
JP   C,ST_OFAIL
ST_SELOO:
LD   A,(ST_SREM)
OR   A
JR   Z,ST_SDONE
CALL ST_STAKE
CP   $5C
JR   NZ,ST_SEMIT
CALL ST_STAKE
CP   $30
JR   Z,ST_SZERO
CP   $6E
JR   Z,ST_SNEWL
CP   $72
JR   Z,ST_SRETU
CP   $74
JR   Z,ST_STAB
CP   $78
JR   Z,ST_SHEX
JR   ST_SEMIT
ST_SZERO:
XOR  A
JR   ST_SEMIT
ST_SNEWL:
LD   A,$0A
JR   ST_SEMIT
ST_SRETU:
LD   A,$0D
JR   ST_SEMIT
ST_STAB:
LD   A,$09
JR   ST_SEMIT
ST_SHEX:
CALL ST_STAKE
CALL TK_HDIGI
JP   NC,ST_DSTR1
ADD  A,A
ADD  A,A
ADD  A,A
ADD  A,A
LD   (ST_SNIBB),A
CALL ST_STAKE
CALL TK_HDIGI
JP   NC,ST_DSTR1
LD   HL,ST_SNIBB
OR   (HL)
ST_SEMIT:
LD   C,A
LD   A,(ST_SMODE)
CP   3
LD   A,C
JR   NZ,ST_SEREA
LD   HL,ST_SREM
LD   A,(HL)
OR   A
LD   A,C
JR   NZ,ST_SEREA
OR   $80
ST_SEREA:
CALL OU_EMITB
JP   C,ST_OFAIL
JR   ST_SELOO
ST_SDONE:
LD   A,(ST_SMODE)
OR   A
JR   Z,ST_SDDON
CP   1
JP   NZ,ST_NEXT
XOR  A
CALL OU_EMITB
JP   C,ST_OFAIL
JP   ST_NEXT
ST_SDDON:
CALL TK_NEXT
JP   C,ST_LFAIL
JP   ST_DDELI
ST_CSTR1:
LD   A,1
JR   ST_SDIR1
ST_PSTR1:
LD   A,2
JR   ST_SDIR1
ST_ISTR1:
LD   A,3
ST_SDIR1:
LD   (ST_SMODE),A
LD   A,(TK_REC+TK_KOFF)
CP   TK_STRIN
JP   NZ,ST_DSTR1
JP   ST_DSTRI
ST_DS1:
LD   BC,(OU_CURSO)
CALL EX_PDEFR
JP   C,ST_DFAIL
OR   A
JP   NZ,ST_DUNR1
LD   (ST_DCNT),HL
LD   A,(TK_REC+TK_KOFF)
CP   TK_EOL
JR   Z,ST_DRESE
CP   TK_COMMA
JP   NZ,ST_DDEL1
CALL TK_NEXT
JP   C,ST_LFAIL
LD   BC,(OU_CURSO)
CALL EX_PDEFR
JP   C,ST_DFAIL
OR   A
JP   NZ,ST_DUNR1
LD   A,L
LD   (ST_DFILL),A
LD   A,(TK_REC+TK_KOFF)
CP   TK_EOL
JP   NZ,ST_DDEL1
LD   HL,(ST_DCNT)
CALL OU_CCAP
JP   C,ST_OFAIL
ST_DFLOO:
LD   HL,(ST_DCNT)
LD   A,H
OR   L
JP   Z,ST_NEXT
LD   A,(ST_DFILL)
CALL OU_EMITB
JP   C,ST_OFAIL
LD   HL,(ST_DCNT)
DEC  HL
LD   (ST_DCNT),HL
JR   ST_DFLOO
ST_DRESE:
LD   HL,(ST_DCNT)
CALL OU_RESER
JP   C,ST_OFAIL
JP   ST_NEXT
ST_ALIG1:
LD   BC,(OU_CURSO)
CALL EX_PDEFR
JP   C,ST_DFAIL
OR   A
JP   NZ,ST_DUNR1
LD   A,(EX_RVAL+2)
OR   A
JP   NZ,ST_DRANG
LD   A,H
OR   L
JP   Z,ST_DRANG
LD   (ST_DVAL),HL
LD   A,(TK_REC+TK_KOFF)
CP   TK_EOL
JP   NZ,ST_DDEL1
LD   HL,(OU_CURSO)
LD   (EX_LVAL),HL
XOR  A
LD   (EX_LVAL+2),A
LD   HL,(ST_DVAL)
LD   (EX_RVAL),HL
LD   (EX_RVAL+2),A
CALL EX_REMAI
JP   C,ST_DFAIL
LD   HL,(EX_RVAL)
LD   A,H
OR   L
JR   Z,ST_ACREA
EX   DE,HL
LD   HL,(ST_DVAL)
OR   A
SBC  HL,DE
ST_ACREA:
LD   (ST_DCNT),HL
XOR  A
LD   (ST_DFILL),A
LD   HL,(ST_DCNT)
CALL OU_CCAP
JP   C,ST_OFAIL
JP   ST_DFLOO
ST_SUCCE:
XOR  A
RET
;@ROUTINE IN B,HL OUT A,CARRY CLOBBERS BC,HL,IX,ZERO,SIGN,PARITY,HALFCARRY,DE
EN_RDIR:
LD   A,B
LD   (ST_DLEN),A
LD   DE,EN_SCRAT
CALL EN_R40PK
RET  C
LD   IX,ST_DTABL
LD   B,ST_CNT
EN_RDLOO:
LD   A,(ST_DLEN)
CP   (IX+2)
JR   NZ,EN_RDNEX
LD   A,(EN_SCRAT)
CP   (IX+0)
JR   NZ,EN_RDNEX
LD   A,(EN_SCRAT+1)
CP   (IX+1)
JR   NZ,EN_RDNEX
LD   A,(IX+3)
OR   A
RET
EN_RDNEX:
LD   DE,4
ADD  IX,DE
DJNZ EN_RDLOO
XOR  A
SCF
RET
ST_DTABL:
DW $21FD
DB 3,ST_EQU
DW $6097
DB 3,ST_ORG
DW $1950
DB 2,ST_DB
DW $1C98
DB 2,ST_DW
DW $1BF8
DB 2,ST_DS
DW $15CC
DB 4,ST_CSTR
DW $670C
DB 4,ST_PSTR
DW $3B4C
DB 4,ST_ISTR
DW $0829
DB 5,ST_ALIGN
;@ROUTINE OUT A CLOBBERS HL,ZERO,SIGN,PARITY,HALFCARRY
ST_STAKE:
LD   HL,(ST_SPTR)
LD   A,(HL)
INC  HL
LD   (ST_SPTR),HL
LD   HL,ST_SREM
DEC  (HL)
RET
;@ROUTINE OUT CARRY CLOBBERS A,HL,ZERO,SIGN,PARITY,HALFCARRY
ST_CPOSI:
LD   A,(TK_REC+TK_POFF)
LD   (ST_EPART),A
LD   HL,(TK_REC+TK_SOFF)
LD   (ST_EOFF),HL
RET
;@ROUTINE IN A OUT A,CARRY CLOBBERS HL,HALFCARRY,ZERO,SIGN,PARITY
ST_LFAIL:
LD   (ST_DETAI),A
LD   A,(TK_EPART)
LD   (ST_EPART),A
LD   HL,(TK_EOFF)
LD   (ST_EOFF),HL
LD   A,ST_SLEXI
SCF
RET
;@ROUTINE OUT A,CARRY CLOBBERS HL,ZERO,SIGN,PARITY,HALFCARRY
ST_EHERE:
CALL ST_CPOSI
LD   A,(TK_REC+TK_KOFF)
CP   TK_DIR
JR   Z,ST_UDIR
JP   ST_ESAVE
;@ROUTINE OUT A,CARRY CLOBBERS HALFCARRY,ZERO,SIGN,PARITY
ST_UDIR:
LD   A,TK_DIR
LD   (ST_DETAI),A
LD   A,ST_SDIR
SCF
RET
;@ROUTINE OUT A,CARRY CLOBBERS HALFCARRY,ZERO,SIGN,PARITY
ST_ESAVE:
LD   A,(TK_REC+TK_KOFF)
LD   (ST_DETAI),A
LD   A,ST_SEXP
SCF
RET
;@ROUTINE IN A OUT A,CARRY CLOBBERS HALFCARRY,ZERO,SIGN,PARITY
ST_SFAIL:
LD   (ST_DETAI),A
LD   A,ST_SSYM
SCF
RET
ST_SPFAI:
LD   A,SY_SPCA1
JR   ST_SFAIL
;@ROUTINE IN A OUT A,CARRY CLOBBERS HALFCARRY,ZERO,SIGN,PARITY
ST_IFAIL:
LD   (ST_DETAI),A
LD   A,ST_SINS
SCF
RET
;@ROUTINE IN A OUT A,CARRY CLOBBERS HALFCARRY,ZERO,SIGN,PARITY
ST_OFAIL:
LD   (ST_DETAI),A
LD   A,ST_SOUT
SCF
RET
;@ROUTINE IN A OUT A,CARRY CLOBBERS HALFCARRY,ZERO,SIGN,PARITY
ST_EFAIL:
LD   (ST_DETAI),A
LD   A,ST_SEQUA
SCF
RET
ST_EUNRE:
LD   A,EX_UNRES
JR   ST_EFAIL
ST_EDELI:
LD   A,EX_SEPRI
JR   ST_EFAIL
;@ROUTINE IN A OUT A,CARRY CLOBBERS HALFCARRY,ZERO,SIGN,PARITY
ST_DFAIL:
LD   (ST_DETAI),A
LD   A,ST_SDIR
SCF
RET
ST_DUNR1:
LD   A,EX_UNRES
JR   ST_DFAIL
ST_DRANG:
LD   A,EX_SRANG
JR   ST_DFAIL
ST_DEXP:
LD   A,EX_SEPRI
JR   ST_DFAIL
ST_DDEL1:
LD   A,(TK_REC+TK_KOFF)
JR   ST_DFAIL
ST_DSTR1:
LD   A,TK_STRIN
JR   ST_DFAIL
ST_CEND:
ST_WBEG:
ST_KEY: DS 6
ST_INS: DS 10
ST_MNEM: DB 0
ST_MVALI: DB 0
ST_DETAI: DB 0
ST_EPART: DB 0
ST_EOFF: DW 0
ST_DLEN: DB 0
ST_EVAL: DW 0
ST_ESIGN: DB 0
ST_DIR: DB 0
ST_DVALI: DB 0
ST_DWIDT: DB 0
ST_DPKIN: DB 0
ST_DADDE: DB 0
ST_DFILL: DB 0
ST_DVAL: DW 0
ST_DPKI1 EQU ST_DVAL
ST_DCNT: DW 0
ST_DKEY: DW 0
ST_DSYM: DW 0
ST_DADR: DW 0
ST_SPTR: DW 0
ST_SREM: DB 0
ST_SCNT: DB 0
ST_SNIBB: DB 0
ST_SMODE: DB 0
ST_WEND:
DR_CBEG:
DR_SOK EQU 0
DR_SCFG EQU 1
DR_SSRC EQU 2
DR_SUNDE EQU 3
DR_SOUT EQU 4
DR_SINT EQU 5
DR_CPCNT EQU 1
DR_CTRAN EQU 2
DR_CPORD EQU 3
DR_CSRAN EQU 4
DR_CSRA1 EQU 5
DR_CPRAN EQU 6
DR_CORAN EQU 7
DR_PCAP EQU 16
DR_PDB EQU 5
DR_PORDI EQU 0
DR_PBEG EQU 1
DR_PEND EQU 3
DR_DPCNT EQU 0
DR_DPART EQU 1
DR_DSBEG EQU 3
DR_DSEND EQU 5
DR_DPBEG EQU 7
DR_DPEND EQU 9
DR_DTBEG EQU 11
DR_DTB EQU 13
DR_DESCB EQU 15
;@ROUTINE IN IX OUT A,CARRY CLOBBERS BC,DE,HL,IX,IY,ZERO,SIGN,PARITY,HALFCARRY
DR_ASM:
PUSH IX
POP  HL
LD   (DR_DESC),HL
XOR  A
LD   (DR_DETAI),A
LD   (DR_USYM),A
LD   (DR_USYM+1),A
CALL DR_VDESC
RET  C
LD   IX,(DR_DESC)
LD   L,(IX+DR_DSBEG)
LD   H,(IX+DR_DSBEG+1)
LD   E,(IX+DR_DSEND)
LD   D,(IX+DR_DSEND+1)
CALL SY_RESET
JP   C,DR_IFAIL
LD   IX,(DR_DESC)
