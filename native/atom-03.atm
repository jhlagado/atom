PR_ROSCR: DB 0
PR_RASCR: DW 0
PR_QBASE: DW 0
PR_RBLD: DS PR_BRB*PR_RCAP
PR_REFER: DS PR_PRB*PR_RCAP
PR_WEND:
OU_CBEG:
OU_SCAP EQU 1
OU_SINT EQU 2
OU_SVRAN EQU 3
OU_SRRAN EQU 4
;@ROUTINE IN DE,HL OUT A,CARRY CLOBBERS SIGN,PARITY,HALFCARRY,ZERO
OU_RESET:
LD   (OU_CURSO),HL
LD   (OU_REM),DE
XOR  A
RET
