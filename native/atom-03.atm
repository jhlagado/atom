PR_OWTEN:
PR_IEND:
PR_CEND:
PR_WBEG:
PR_DST: DW 0
PR_IADR: DW 0
PR_IPART: DB 0
PR_IOFF: DW 0
PR_ILEN: DB 0
PR_OPCNT: DB 0
PR_SINDE: DB 0
PR_FMASK: DB 0
PR_CMASK: DB 0
PR_CPTR: DW 0
PR_VPTR: DW 0
PR_LCLAS: DB 0
PR_MBASE: DB 0
PR_ICLAS: DB 0
PR_DSIGN: DB 0
PR_NKEY: DS 6
PR_ESTAT: DB 0
PR_EPART: DB 0
PR_EOFF: DW 0
PR_SCRAT: DS 10
PR_ESTA1: DB 0
PR_SSTAT: DB 0
PR_RCNT: DB 0
PR_RBCNT: DB 0
PR_UMASK: DB 0
PR_RSCAN: DB 0
PR_RMCNT: DB 0
