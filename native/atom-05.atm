LD   L,(IX+DR_DPBEG)
LD   H,(IX+DR_DPBEG+1)
LD   E,(IX+DR_DPEND)
LD   D,(IX+DR_DPEND+1)
CALL SY_RESE1
JP   C,DR_IFAIL
LD   IX,(DR_DESC)
LD   L,(IX+DR_DTBEG)
LD   H,(IX+DR_DTBEG+1)
LD   E,(IX+DR_DTB)
LD   D,(IX+DR_DTB+1)
CALL OU_RESET
JP   C,DR_IFAIL
LD   IX,(DR_DESC)
CALL HS_BEG
JP   C,DR_BFAIL
LD   IX,(DR_DESC)
LD   A,(IX+DR_DPCNT)
LD   (DR_PREM),A
LD   L,(IX+DR_DPART)
LD   H,(IX+DR_DPART+1)
LD   (DR_PCURS),HL
XOR  A
LD   (DR_PINDE),A
DR_PLOOP:
LD   A,(DR_PREM)
OR   A
JR   Z,DR_FIN
LD   HL,(DR_PCURS)
INC  HL
LD   E,(HL)
INC  HL
LD   D,(HL)
INC  HL
PUSH DE
LD   E,(HL)
INC  HL
LD   D,(HL)
INC  HL
LD   (DR_PCURS),HL
POP  HL
LD   A,(DR_PINDE)
CALL TK_RESET
JP   C,DR_IABOR
CALL DR_APART
JR   C,DR_SFAIL
LD   HL,DR_PINDE
INC  (HL)
LD   HL,DR_PREM
DEC  (HL)
JR   DR_PLOOP
DR_FIN:
CALL DR_AFIN
JR   C,DR_FFAIL
LD   IX,(DR_DESC)
LD   HL,(OU_CURSO)
LD   DE,(OU_REM)
CALL HS_CMT
JR   C,DR_CFAIL
XOR  A
RET
DR_SFAIL:
LD   (DR_DETAI),A
LD   A,DR_SSRC
JR   DR_ABORT
DR_FFAIL:
LD   (DR_DETAI),A
CP   ST_SUNDE
LD   A,DR_SUNDE
JR   Z,DR_ABORT
LD   A,DR_SINT
JR   DR_ABORT
DR_IABOR:
LD   (DR_DETAI),A
LD   A,DR_SINT
JR   DR_ABORT
DR_CFAIL:
LD   (DR_DETAI),A
LD   A,DR_SOUT
DR_ABORT:
PUSH AF
CALL HS_ABORT
POP  AF
SCF
RET
DR_BFAIL:
LD   (DR_DETAI),A
LD   A,DR_SOUT
SCF
RET
DR_IFAIL:
LD   (DR_DETAI),A
LD   A,DR_SINT
SCF
RET
;@ROUTINE OUT A,CARRY CLOBBERS BC,DE,IX,SIGN,PARITY,HALFCARRY,HL,ZERO,IY
DR_VDESC:
LD   IX,(DR_DESC)
LD   A,(IX+DR_DPCNT)
OR   A
JP   Z,DR_BPCNT
CP   DR_PCAP+1
JP   NC,DR_BPCNT
LD   (DR_PREM),A
LD   L,(IX+DR_DPART)
LD   H,(IX+DR_DPART+1)
LD   (DR_PCURS),HL
LD   C,A
LD   B,0
PUSH HL
LD   H,B
LD   L,C
ADD  HL,HL
ADD  HL,HL
ADD  HL,BC
POP  DE
ADD  HL,DE
JR   C,DR_BPTAB
XOR  A
LD   (DR_PINDE),A
DR_VPLOO:
LD   A,(DR_PREM)
OR   A
JR   Z,DR_VAREN
LD   HL,(DR_PCURS)
LD   A,(DR_PINDE)
CP   (HL)
JR   NZ,DR_BPORD
INC  HL
LD   E,(HL)
INC  HL
LD   D,(HL)
INC  HL
LD   C,(HL)
INC  HL
LD   B,(HL)
INC  HL
LD   (DR_PCURS),HL
LD   H,B
LD   L,C
OR   A
SBC  HL,DE
JR   C,DR_BSRAN
LD   HL,DR_PINDE
INC  (HL)
LD   HL,DR_PREM
DEC  (HL)
JR   DR_VPLOO
DR_VAREN:
LD   IX,(DR_DESC)
LD   L,(IX+DR_DSBEG)
LD   H,(IX+DR_DSBEG+1)
LD   E,(IX+DR_DSEND)
LD   D,(IX+DR_DSEND+1)
CALL DR_VRANG
JR   C,DR_BSRA1
LD   IX,(DR_DESC)
LD   L,(IX+DR_DPBEG)
LD   H,(IX+DR_DPBEG+1)
LD   E,(IX+DR_DPEND)
LD   D,(IX+DR_DPEND+1)
CALL DR_VRANG
JR   C,DR_BPRAN
LD   IX,(DR_DESC)
LD   L,(IX+DR_DTBEG)
LD   H,(IX+DR_DTBEG+1)
LD   E,(IX+DR_DTB)
LD   D,(IX+DR_DTB+1)
ADD  HL,DE
JR   C,DR_BORAN
XOR  A
RET
;@ROUTINE IN HL,DE OUT A,CARRY CLOBBERS ZERO,SIGN,PARITY,HALFCARRY,HL,DE
DR_VRANG:
EX   DE,HL
OR   A
SBC  HL,DE
RET  NC
SCF
RET
DR_BPCNT:
LD   A,DR_CPCNT
JR   DR_CFAI1
DR_BPTAB:
LD   A,DR_CTRAN
JR   DR_CFAI1
DR_BPORD:
LD   A,DR_CPORD
JR   DR_CFAI1
DR_BSRAN:
LD   A,DR_CSRAN
JR   DR_CFAI1
DR_BSRA1:
LD   A,DR_CSRA1
JR   DR_CFAI1
DR_BPRAN:
LD   A,DR_CPRAN
JR   DR_CFAI1
DR_BORAN:
LD   A,DR_CORAN
DR_CFAI1:
LD   (DR_DETAI),A
LD   A,DR_SCFG
SCF
RET
;@ROUTINE OUT A,CARRY,IX CLOBBERS DE,ZERO,SIGN,PARITY,HALFCARRY,HL,BC,IY
DR_AFIN:
LD   IX,(SY_ABAS1)
LD   DE,(SY_NEXT)
PUSH IX
POP  HL
OR   A
SBC  HL,DE
JR   Z,DR_FNPEN
DR_FPLOO:
BIT  7,(IX+4)
JR   NZ,DR_FANCH
LD   BC,SY_RECB1
ADD  IX,BC
PUSH IX
POP  HL
OR   A
SBC  HL,DE
JR   NZ,DR_FPLOO
JR   DR_FINT
DR_FANCH:
LD   L,(IX+0)
LD   H,(IX+1)
LD   (DR_USYM),HL
CALL DR_VSPTR
JR   C,DR_FINT
LD   IY,(DR_USYM)
BIT  6,(IY+5)
JR   NZ,DR_FINT
LD   A,(IX+4)
AND  SY_KMASK
JR   Z,DR_FINT
CP   PT_KHB+1
JR   NC,DR_FINT
LD   A,(IX+4)
AND  SY_PMASK
RRCA
RRCA
RRCA
LD   (ST_EPART),A
LD   L,(IY+SY_VALLO)
LD   H,(IY+SY_VALHI)
LD   (ST_EOFF),HL
XOR  A
LD   (ST_DETAI),A
LD   IX,(DR_USYM)
LD   A,ST_SUNDE
SCF
RET
DR_FNPEN:
CALL SY_VSCOP
JR   C,DR_FINT
LD   IX,(SY_ABASE)
LD   DE,(SY_GEND)
DR_FGLOO:
PUSH IX
POP  HL
OR   A
SBC  HL,DE
JR   Z,DR_FSUCC
BIT  6,(IX+5)
JR   Z,DR_FINT
LD   BC,SY_RECB
ADD  IX,BC
JR   DR_FGLOO
DR_FSUCC:
XOR  A
RET
DR_FINT:
XOR  A
LD   (DR_USYM),A
LD   (DR_USYM+1),A
LD   A,ST_SINT
SCF
RET
;@ROUTINE IN HL OUT A,CARRY CLOBBERS DE,HL,ZERO,SIGN,PARITY,HALFCARRY,BC
DR_VSPTR:
PUSH HL
LD   DE,(SY_ABASE)
OR   A
SBC  HL,DE
POP  HL
JR   C,DR_VPPTR
PUSH HL
LD   DE,(SY_GEND)
OR   A
SBC  HL,DE
POP  HL
JR   NC,DR_VPPTR
LD   DE,(SY_ABASE)
OR   A
SBC  HL,DE
LD   A,L
AND  SY_RECB-1
RET  Z
SCF
RET
DR_VPPTR:
PUSH HL
LD   DE,(SY_LBEG)
OR   A
SBC  HL,DE
POP  HL
RET  C
PUSH HL
LD   DE,(SY_AEND)
OR   A
SBC  HL,DE
POP  HL
JR   NC,DR_ISPTR
LD   DE,(SY_AEND)
EX   DE,HL
OR   A
SBC  HL,DE
LD   A,L
AND  SY_RECB-1
RET  Z
DR_ISPTR:
SCF
RET
DR_CEND:
DR_WBEG:
DR_DESC: DW 0
DR_PCURS: DW 0
DR_PREM: DB 0
DR_PINDE: DB 0
DR_DETAI: DB 0
DR_USYM: DW 0
DR_WEND:
HS_SCBEG:
;@ROUTINE IN IX OUT A,CARRY CLOBBERS HALFCARRY,ZERO,SIGN,PARITY
HS_BEG:
LD   A,$FF
SCF
RET
;@ROUTINE IN A,C,HL OUT A,CARRY CLOBBERS HALFCARRY,ZERO,SIGN,PARITY
HS_IB:
LD   A,$FF
SCF
RET
;@ROUTINE IN A,C,HL OUT A,CARRY CLOBBERS HALFCARRY,ZERO,SIGN,PARITY
HS_PB:
LD   A,$FF
SCF
RET
;@ROUTINE IN C,DE,HL OUT A,CARRY CLOBBERS HALFCARRY,ZERO,SIGN,PARITY
HS_PW:
LD   A,$FF
SCF
RET
;@ROUTINE IN IX,HL,DE OUT A,CARRY CLOBBERS HALFCARRY,ZERO,SIGN,PARITY
HS_CMT:
LD   A,$FF
SCF
RET
;@ROUTINE OUT A,CARRY CLOBBERS HALFCARRY,ZERO,SIGN,PARITY
HS_ABORT:
LD   A,$FF
SCF
RET
HS_SCEND:
HS_REND:
