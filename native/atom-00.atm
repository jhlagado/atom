ORG 0
EN_MNEM EQU 0
EN_OP0 EQU 1
EN_OP1 EQU 2
EN_OP2 EQU 3
EN_VAL0 EQU 4
EN_VAL1 EQU 6
EN_VAL2 EQU 8
EN_B EQU 0
EN_C EQU 1
EN_D EQU 2
EN_E EQU 3
EN_H EQU 4
EN_L EQU 5
EN_MEMHL EQU 6
EN_A EQU 7
EN_BC EQU 8
EN_DE EQU 9
EN_HL EQU 10
EN_SP EQU 11
EN_AF EQU 15
EN_IX EQU 16
EN_IY EQU 17
EN_IXH EQU 20
EN_IXL EQU 21
EN_IYH EQU 28
