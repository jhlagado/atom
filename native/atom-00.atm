PUSH AF
;@EXPECTOUT A
CALL EN_PFOP
LD   (EN_SCRAT+0),A
POP  AF
AND  7
LD   B,A
LD   A,(IX+EN_OP0)
ADD  A,A
ADD  A,A
ADD  A,A
ADD  A,B
ADD  A,$40
