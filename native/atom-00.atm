EN_MEMDE EQU 41
EN_IIX EQU 48
EN_IIY EQU 49
EN_MABS EQU 50
EN_IMM8 EQU 51
EN_IMM16 EQU 52
EN_PORTC EQU 53
EN_REL8 EQU 54
EN_ZERO EQU 55
EN_MEMIX EQU 56
EN_MEMIY EQU 57
EN_MEMSP EQU 58
EN_APRIM EQU 59
EN_NZ EQU 64
EN_Z EQU 65
EN_NC EQU 66
EN_CC EQU 67
EN_PO EQU 68
EN_PE EQU 69
EN_P EQU 70
EN_M EQU 71
EN_BIT0 EQU 72
EN_BIT7 EQU 79
EN_RST0 EQU 80
EN_RST56 EQU 87
EN_IM0 EQU 88
EN_IM2 EQU 90
EN_NONE EQU 255
AT_MNOP EQU 1
AT_MRET EQU 35
AT_MEX EQU 36
AT_MIM EQU 37
AT_MRST EQU 38
AT_MINC EQU 39
AT_MDEC EQU 40
AT_MPUSH EQU 41
AT_MPOP EQU 42
AT_MLD EQU 43
AT_MIN EQU 44
AT_MOUT EQU 45
AT_MBIT EQU 46
AT_MRES EQU 47
AT_MSET EQU 48
AT_MRLC EQU 49
AT_MSRL EQU 57
AT_MADD EQU 58
AT_MADC EQU 59
AT_MSUB EQU 60
AT_MSBC EQU 61
AT_MAND EQU 62
AT_MXOR EQU 63
AT_MOR EQU 64
AT_MCP EQU 65
AT_MJP EQU 66
AT_MCALL EQU 67
AT_MJR EQU 68
AT_MDJNZ EQU 69
AT_MLAST EQU AT_MDJNZ
EN_COREB:
EN_CODEB:
EN_R4CBE:
;@ROUTINE IN B,HL,DE OUT DE,CARRY MAYBE-OUT ZERO CLOBBERS A,BC,HL,IX,SIGN,PARITY,HALFCARRY,ZERO
EN_R40PK:
LD   A,B
OR   A
JP   Z,.PINVALID
CP   9
JP   NC,.PINVALID
PUSH HL
PUSH BC
.PVLOOP:
LD   A,(HL)
CALL EN_R40CH
JP   C,.PVFAILED
INC  HL
DJNZ .PVLOOP
POP  BC
POP  HL
PUSH DE
LD   IX,EN_SCRAT
LD   A,B
CP   3
JR   C,.PFSHORT
LD   B,3
SUB  3
JR   .PFREADY
.PFSHORT:
LD   B,A
XOR  A
.PFREADY:
PUSH AF
LD   C,3
;@EXPECTOUT DE
CALL EN_PGROU
LD   (IX+0),E
LD   (IX+1),D
POP  AF
CP   3
JR   C,.PSSHORT
LD   B,3
SUB  3
JR   .PSREADY
.PSSHORT:
LD   B,A
XOR  A
.PSREADY:
PUSH AF
LD   C,3
;@EXPECTOUT DE
CALL EN_PGROU
LD   (IX+2),E
LD   (IX+3),D
POP  AF
LD   B,A
LD   C,2
;@EXPECTOUT DE
CALL EN_PGROU
LD   (IX+4),E
LD   (IX+5),D
POP  DE
LD   HL,EN_SCRAT
LD   BC,6
LDIR
OR   A
RET
.PVFAILED:
POP  BC
POP  HL
.PINVALID:
XOR  A
SCF
RET
;@ROUTINE IN BC,HL OUT DE,HL,CARRY MAYBE-OUT ZERO CLOBBERS A,SIGN,PARITY,HALFCARRY,BC,ZERO
EN_PGROU:
LD   DE,0
.PGLOOP:
LD   A,B
OR   A
JR   Z,.PGPADDIN
LD   A,(HL)
INC  HL
DEC  B
CALL EN_R40CH
JR   .PGAPPEND
.PGPADDIN:
XOR  A
.PGAPPEND:
CALL AT_MA40
DEC  C
JR   NZ,.PGLOOP
OR   A
RET
;@ROUTINE IN DE,A OUT DE CLOBBERS A,F
AT_MA40:
PUSH HL
LD   H,D
LD   L,E
ADD  HL,HL
ADD  HL,HL
ADD  HL,DE
ADD  HL,HL
ADD  HL,HL
ADD  HL,HL
ADD  A,L
LD   L,A
JR   NC,.MA4NCARR
INC  H
.MA4NCARR:
EX   DE,HL
POP  HL
RET
;@ROUTINE IN A OUT A,CARRY MAYBE-OUT ZERO CLOBBERS SIGN,PARITY,HALFCARRY,ZERO
EN_R40CH:
CP   $61
JR   C,.R4UPPER
CP   $7A+1
JR   NC,.R4UPPER
SUB  $20
.R4UPPER:
CP   $41
JR   C,.R4DIGIT
CP   $5A+1
JR   NC,.R4DIGIT
SUB  $41-1
OR   A
RET
.R4DIGIT:
CP   $30
JR   C,.R4UNDERS
CP   $39+1
JR   NC,.R4UNDERS
SUB  $30-27
OR   A
RET
.R4UNDERS:
CP   $5F
JR   NZ,.R4BAD
LD   A,37
OR   A
RET
.R4BAD:
XOR  A
SCF
RET
EN_R4CEN:
EN_RCBEG:
;@ROUTINE IN B,HL OUT A,CARRY CLOBBERS BC,HL,IX,ZERO,SIGN,PARITY,HALFCARRY,DE
EN_RECOG:
LD   DE,EN_SCRAT
CALL EN_R40PK
RET  C
XOR  A
LD   (EN_SLO),A
LD   A,EN_CNT
LD   (EN_SHI),A
.RLOOP:
LD   A,(EN_SLO)
LD   B,A
LD   A,(EN_SHI)
CP   B
JP   Z,.RNFOUND
ADD  A,B
RRCA
AND  $7F
LD   (EN_SMID),A
LD   E,A
LD   D,0
LD   H,D
LD   L,E
ADD  HL,HL
ADD  HL,HL
ADD  HL,DE
LD   DE,EN_TABLE
ADD  HL,DE
INC  HL
LD   A,(EN_SCRAT+1)
CP   (HL)
JR   C,.RBEF
JR   NZ,.RAFT
DEC  HL
LD   A,(EN_SCRAT+0)
CP   (HL)
JR   C,.RBEF
JR   NZ,.RAFT
INC  HL
INC  HL
INC  HL
LD   A,(EN_SCRAT+3)
CP   (HL)
JR   C,.RBEF
JR   NZ,.RAFT
DEC  HL
LD   A,(EN_SCRAT+2)
CP   (HL)
JR   C,.RBEF
JR   NZ,.RAFT
INC  HL
INC  HL
LD   A,(HL)
OR   A
RET
.RBEF:
LD   A,(EN_SMID)
LD   (EN_SHI),A
JR   .RLOOP
.RAFT:
LD   A,(EN_SMID)
INC  A
LD   (EN_SLO),A
JR   .RLOOP
.RNFOUND:
XOR  A
SCF
RET
EN_RCEND:
EN_VCBEG:
;@ROUTINE IN IX OUT A,CARRY CLOBBERS ZERO,SIGN,PARITY,HALFCARRY,B,DE,HL
EN_LEN:
EN_VFORM:
LD   A,(IX+EN_MNEM)
OR   A
JP   Z,AT_INVAL
CP   AT_MRET
JP   C,.VCORE
JP   Z,.VRET
CP   AT_MEX
JP   Z,.VEX
CP   AT_MIM
JP   Z,.VIM
CP   AT_MRST
JP   Z,.VRST
CP   AT_MINC
JP   Z,.VIDEC
CP   AT_MDEC
JP   Z,.VIDEC
CP   AT_MPUSH
JP   Z,.VSTACK
CP   AT_MPOP
JP   Z,.VSTACK
CP   AT_MLD
JP   Z,.VLD
CP   AT_MIN
JP   Z,.VIN
CP   AT_MOUT
JP   Z,.VOUT
CP   AT_MBIT
JP   C,AT_INVAL
CP   AT_MSET+1
JP   C,.VBIT
CP   AT_MRLC
JP   C,AT_INVAL
CP   AT_MSRL+1
JP   C,.VROTATE
CP   AT_MADD
JP   C,AT_INVAL
CP   AT_MCP+1
JP   C,.VALU
CP   AT_MJP
JP   Z,.VJP
CP   AT_MCALL
JP   Z,.VCALL
CP   AT_MJR
JP   Z,.VJR
CP   AT_MDJNZ
JP   Z,.VDJNZ
JP   AT_INVAL
.VCORE:
CALL AT_RNOPE
RET  C
LD   A,(IX+EN_MNEM)
DEC  A
ADD  A,A
LD   E,A
LD   D,0
LD   HL,EN_COPCO+1
ADD  HL,DE
LD   A,(HL)
OR   A
LD   A,1
RET  Z
INC  A
RET
.VRET:
LD   A,(IX+EN_OP0)
CP   EN_NONE
JP   Z,.VL1NOPER
CALL EN_ICOND
JP   NC,AT_INVAL
CALL AT_ROOP
RET  C
LD   A,1
OR   A
RET
.VL1NOPER:
CALL AT_RNOPE
RET  C
LD   A,1
OR   A
RET
.VEX:
CALL AT_RTOPE
RET  C
LD   A,(IX+EN_OP0)
CP   EN_AF
JR   Z,.VEAF
CP   EN_DE
JR   Z,.VEDE
CP   EN_MEMSP
JP   NZ,AT_INVAL
LD   A,(IX+EN_OP1)
CP   EN_HL
JP   Z,.VL1
CP   EN_IX
JP   Z,.VL2
CP   EN_IY
JP   Z,.VL2
JP   AT_INVAL
.VEAF:
LD   A,(IX+EN_OP1)
CP   EN_APRIM
JP   Z,.VL1
JP   AT_INVAL
.VEDE:
LD   A,(IX+EN_OP1)
CP   EN_HL
JP   Z,.VL1
JP   AT_INVAL
.VIM:
CALL AT_ROOP
RET  C
LD   A,(IX+EN_OP0)
CP   EN_IM0
JP   C,AT_INVAL
CP   EN_IM2+1
JP   NC,AT_INVAL
JP   .VL2
.VRST:
CALL AT_ROOP
RET  C
LD   A,(IX+EN_OP0)
CP   EN_RST0
JP   C,AT_INVAL
CP   EN_RST56+1
JP   NC,AT_INVAL
JP   .VL1
.VIDEC:
CALL AT_ROOP
RET  C
LD   A,(IX+EN_OP0)
CALL EN_IR8
JP   C,.VL1
LD   A,(IX+EN_OP0)
CALL EN_IR16
JP   C,.VL1
LD   A,(IX+EN_OP0)
CP   EN_IX
JP   Z,.VL2
CP   EN_IY
JP   Z,.VL2
CALL EN_IHIND
JP   C,.VL2
LD   A,(IX+EN_OP0)
CP   EN_MEMHL
JP   Z,.VL1
CALL EN_IINDE
JP   C,.VL3
JP   AT_INVAL
.VSTACK:
CALL AT_ROOP
RET  C
LD   A,(IX+EN_OP0)
CP   EN_BC
JP   Z,.VL1
CP   EN_DE
JP   Z,.VL1
CP   EN_HL
JP   Z,.VL1
CP   EN_AF
JP   Z,.VL1
CP   EN_IX
JP   Z,.VL2
CP   EN_IY
JP   Z,.VL2
JP   AT_INVAL
EN_LVBEG EQU $
.VLD:
CALL AT_RTOPE
RET  C
LD   A,(IX+EN_OP0)
CALL EN_IR8
JP   C,.VLR8
LD   A,(IX+EN_OP0)
CALL EN_IHIND
JP   C,.VLHALF
LD   A,(IX+EN_OP0)
CALL EN_IR16
JP   C,.VLR16
LD   A,(IX+EN_OP0)
CP   EN_IX
JP   Z,.VLI16
CP   EN_IY
JP   Z,.VLI16
CP   EN_I
JP   Z,.VLSPECIA
CP   EN_R
JP   Z,.VLSPECIA
CP   EN_MABS
JP   Z,.VLMABS
CP   EN_MEMBC
JP   Z,.VLMPAIR
CP   EN_MEMDE
JP   Z,.VLMPAIR
CP   EN_MEMHL
JP   Z,.VLMHL
CALL EN_IINDE
JP   C,.VLINDEXE
JP   AT_INVAL
.VLR8:
LD   A,(IX+EN_OP1)
CALL EN_IR8
JP   C,.VL1
LD   A,(IX+EN_OP1)
CP   EN_IMM8
JP   Z,.VL2
CP   EN_MEMHL
JP   Z,.VL1
CP   EN_MABS
JR   Z,.VLR8ABSO
CP   EN_MEMBC
JR   Z,.VLR8ACCU
CP   EN_MEMDE
JR   Z,.VLR8ACCU
CP   EN_I
JR   Z,.VLR8A2
CP   EN_R
JR   Z,.VLR8A2
CALL EN_IINDE
JP   C,.VL3
LD   A,(IX+EN_OP1)
CALL EN_IHIND
JP   NC,AT_INVAL
LD   A,(IX+EN_OP0)
CP   EN_H
JP   Z,AT_INVAL
CP   EN_L
JP   Z,AT_INVAL
JP   .VL2
.VLR8ABSO:
.VLR8ACCU:
LD   A,(IX+EN_OP0)
CP   EN_A
JP   NZ,AT_INVAL
LD   A,(IX+EN_OP1)
CP   EN_MABS
JP   Z,.VL3
JP   .VL1
.VLR8A2:
LD   A,(IX+EN_OP0)
CP   EN_A
JP   NZ,AT_INVAL
JP   .VL2
.VLHALF:
LD   A,(IX+EN_OP1)
CALL EN_IHIND
JR   C,.VLHFAMIL
LD   A,(IX+EN_OP1)
CALL EN_IR8
JP   NC,AT_INVAL
CP   EN_H
JP   Z,AT_INVAL
CP   EN_L
JP   Z,AT_INVAL
JP   .VL2
.VLHFAMIL:
LD   A,(IX+EN_OP0)
LD   B,A
LD   A,(IX+EN_OP1)
XOR  B
AND  $08
JP   NZ,AT_INVAL
JP   .VL2
.VLR16:
LD   A,(IX+EN_OP1)
CP   EN_IMM16
JP   Z,.VL3
CP   EN_MABS
JR   Z,.VLR1ABSO
LD   A,(IX+EN_OP0)
CP   EN_SP
JR   Z,.VLSP
CP   EN_HL
JR   Z,.VLLHL
CP   EN_BC
JR   Z,.VLLBC
JP   AT_INVAL
.VLR1ABSO:
LD   A,(IX+EN_OP0)
CP   EN_HL
JP   Z,.VL3
JP   .VL4
.VLSP:
LD   A,(IX+EN_OP1)
CP   EN_HL
JP   Z,.VL1
CP   EN_IX
JP   Z,.VL2
CP   EN_IY
JP   Z,.VL2
JP   AT_INVAL
.VLLHL:
.VLLBC:
LD   A,(IX+EN_OP1)
CP   EN_DE
JP   Z,.VL2
JP   AT_INVAL
.VLI16:
LD   A,(IX+EN_OP1)
CP   EN_IMM16
JP   Z,.VL4
CP   EN_MABS
JP   Z,.VL4
JP   AT_INVAL
.VLSPECIA:
LD   A,(IX+EN_OP1)
CP   EN_A
JP   Z,.VL2
JP   AT_INVAL
.VLMABS:
LD   A,(IX+EN_OP1)
CP   EN_A
JP   Z,.VL3
CALL EN_IR16
JR   NC,.VLMAINDE
CP   EN_HL
JP   Z,.VL3
JP   .VL4
.VLMAINDE:
CP   EN_IX
JP   Z,.VL4
CP   EN_IY
JP   Z,.VL4
JP   AT_INVAL
.VLMPAIR:
LD   A,(IX+EN_OP1)
CP   EN_A
JP   Z,.VL1
JP   AT_INVAL
.VLMHL:
LD   A,(IX+EN_OP1)
CALL EN_IR8
JP   C,.VL1
CP   EN_IMM8
JP   Z,.VL2
JP   AT_INVAL
.VLINDEXE:
LD   A,(IX+EN_OP1)
CALL EN_IR8
JP   C,.VL3
CP   EN_IMM8
JP   Z,.VL4
JP   AT_INVAL
EN_LVEND EQU $
.VIN:
LD   A,(IX+EN_OP0)
CP   EN_PORTC
JR   Z,.VIONE
CALL EN_IR8
JP   NC,AT_INVAL
CALL AT_RTOPE
RET  C
LD   A,(IX+EN_OP1)
CP   EN_PORTC
JP   Z,.VL2
CP   EN_IMM8
JP   NZ,AT_INVAL
LD   A,(IX+EN_OP0)
CP   EN_A
JP   NZ,AT_INVAL
JP   .VL2
.VIONE:
CALL AT_ROOP
RET  C
JP   .VL2
.VOUT:
CALL AT_RTOPE
RET  C
LD   A,(IX+EN_OP0)
CP   EN_PORTC
JR   Z,.VOC
CP   EN_IMM8
JP   NZ,AT_INVAL
LD   A,(IX+EN_OP1)
CP   EN_A
JP   NZ,AT_INVAL
JP   .VL2
.VOC:
LD   A,(IX+EN_OP1)
CP   EN_ZERO
JP   Z,.VL2
CALL EN_IR8
JP   C,.VL2
JP   AT_INVAL
.VBIT:
LD   A,(IX+EN_OP0)
CALL EN_IBIND
JP   NC,AT_INVAL
LD   A,(IX+EN_OP1)
CALL EN_IR8
JR   C,.VBPLAIN
CP   EN_MEMHL
JR   Z,.VBPLAIN
CALL EN_IINDE
JP   NC,AT_INVAL
LD   A,(IX+EN_MNEM)
CP   AT_MBIT
JR   Z,.VBINDST
LD   A,(IX+EN_OP2)
CP   EN_NONE
JP   Z,.VL4
CALL EN_IR8
JP   C,.VL4
JP   AT_INVAL
.VBINDST:
CALL AT_RTOPE
RET  C
JP   .VL4
.VBPLAIN:
CALL AT_RTOPE
RET  C
JP   .VL2
.VROTATE:
LD   A,(IX+EN_OP0)
CALL EN_IR8
JR   C,.VRPLAIN
CP   EN_MEMHL
JR   Z,.VRPLAIN
CALL EN_IINDE
JP   NC,AT_INVAL
CALL AT_RTOPE
RET  C
LD   A,(IX+EN_OP1)
CP   EN_NONE
JP   Z,.VL4
CALL EN_IR8
JP   C,.VL4
JP   AT_INVAL
.VRPLAIN:
CALL AT_ROOP
RET  C
JP   .VL2
.VALU:
LD   A,(IX+EN_OP1)
CP   EN_NONE
JR   NZ,.VA16
CALL AT_ROOP
RET  C
LD   A,(IX+EN_OP0)
CALL EN_IR8
JP   C,.VL1
CP   EN_MEMHL
JP   Z,.VL1
CP   EN_IMM8
JP   Z,.VL2
CALL EN_IHIND
JP   C,.VL2
LD   A,(IX+EN_OP0)
CALL EN_IINDE
JP   C,.VL3
JP   AT_INVAL
.VA16:
CALL AT_RTOPE
RET  C
LD   A,(IX+EN_MNEM)
CP   AT_MADD
JR   Z,.VA161
CP   AT_MADC
JR   Z,.VAS16
CP   AT_MSBC
JP   NZ,AT_INVAL
.VAS16:
LD   A,(IX+EN_OP0)
CP   EN_HL
JP   NZ,AT_INVAL
LD   A,(IX+EN_OP1)
CALL EN_IR16
JP   C,.VL2
JP   AT_INVAL
.VA161:
LD   A,(IX+EN_OP0)
CP   EN_HL
JR   Z,.VAHL
CP   EN_IX
JR   Z,.VAINDEX
CP   EN_IY
JP   NZ,AT_INVAL
.VAINDEX:
LD   B,A
LD   A,(IX+EN_OP1)
CP   EN_BC
JP   Z,.VL2
CP   EN_DE
JP   Z,.VL2
CP   EN_SP
JP   Z,.VL2
CP   B
JP   Z,.VL2
JP   AT_INVAL
.VAHL:
LD   A,(IX+EN_OP1)
CALL EN_IR16
JP   C,.VL1
JP   AT_INVAL
.VJP:
LD   A,(IX+EN_OP1)
CP   EN_NONE
JR   NZ,.VJCONDIT
CALL AT_ROOP
RET  C
LD   A,(IX+EN_OP0)
CP   EN_IMM16
JP   Z,.VL3
CP   EN_MEMHL
JP   Z,.VL1
CP   EN_MEMIX
JP   Z,.VL2
CP   EN_MEMIY
JP   Z,.VL2
JP   AT_INVAL
.VJCONDIT:
CALL AT_RTOPE
RET  C
LD   A,(IX+EN_OP0)
CALL EN_ICOND
JP   NC,AT_INVAL
LD   A,(IX+EN_OP1)
CP   EN_IMM16
JP   Z,.VL3
JP   AT_INVAL
.VCALL:
LD   A,(IX+EN_OP1)
CP   EN_NONE
JR   NZ,.VCCONDIT
CALL AT_ROOP
RET  C
LD   A,(IX+EN_OP0)
CP   EN_IMM16
JP   Z,.VL3
JP   AT_INVAL
.VCCONDIT:
CALL AT_RTOPE
RET  C
LD   A,(IX+EN_OP0)
CALL EN_ICOND
JP   NC,AT_INVAL
LD   A,(IX+EN_OP1)
CP   EN_IMM16
JP   Z,.VL3
JP   AT_INVAL
.VJR:
LD   A,(IX+EN_OP1)
CP   EN_NONE
JR   NZ,.VJCONDI1
CALL AT_ROOP
RET  C
LD   A,(IX+EN_OP0)
CP   EN_REL8
JP   Z,.VL2
JP   AT_INVAL
.VJCONDI1:
CALL AT_RTOPE
RET  C
LD   A,(IX+EN_OP0)
CALL EN_IRCON
JP   NC,AT_INVAL
LD   A,(IX+EN_OP1)
CP   EN_REL8
JP   Z,.VL2
JP   AT_INVAL
.VDJNZ:
CALL AT_ROOP
RET  C
LD   A,(IX+EN_OP0)
CP   EN_REL8
JP   Z,.VL2
JP   AT_INVAL
.VL1:
LD   A,1
OR   A
RET
.VL2:
LD   A,2
OR   A
RET
.VL3:
LD   A,3
OR   A
RET
.VL4:
LD   A,4
OR   A
RET
;@ROUTINE OUT A,CARRY MAYBE-OUT ZERO CLOBBERS SIGN,PARITY,HALFCARRY,ZERO
AT_INVAL:
XOR  A
SCF
RET
;@ROUTINE IN IX OUT A,CARRY CLOBBERS ZERO,SIGN,PARITY,HALFCARRY
AT_RNOPE:
LD   A,(IX+EN_OP0)
CP   EN_NONE
JR   NZ,AT_RBAD
JP   AT_ROOP
;@ROUTINE IN IX OUT A,CARRY CLOBBERS ZERO,SIGN,PARITY,HALFCARRY
AT_ROOP:
LD   A,(IX+EN_OP1)
CP   EN_NONE
JR   NZ,AT_RBAD
JP   AT_RTOPE
;@ROUTINE IN IX OUT A,CARRY CLOBBERS ZERO,SIGN,PARITY,HALFCARRY
AT_RTOPE:
LD   A,(IX+EN_OP2)
CP   EN_NONE
JR   NZ,AT_RBAD
OR   A
RET
;@ROUTINE OUT A,CARRY MAYBE-OUT ZERO CLOBBERS SIGN,PARITY,HALFCARRY,ZERO
AT_RBAD:
XOR  A
SCF
RET
;@ROUTINE IN A OUT CARRY CLOBBERS SIGN,PARITY,HALFCARRY,ZERO
EN_IR8:
CP   EN_MEMHL
JR   C,AT_PYES
CP   EN_A
JR   Z,AT_PYES
CP   A
RET
;@ROUTINE IN A OUT CARRY CLOBBERS ZERO,SIGN,PARITY,HALFCARRY
EN_IR16:
CP   EN_BC
JR   C,AT_PNO
CP   EN_SP+1
JR   C,AT_PYES
CP   A
RET
;@ROUTINE IN A OUT CARRY,ZERO,SIGN,PARITY,HALFCARRY
EN_IHIND:
CP   EN_IXH
JR   Z,AT_PYES
CP   EN_IXL
JR   Z,AT_PYES
CP   EN_IYH
JR   Z,AT_PYES
CP   EN_IYL
JR   Z,AT_PYES
CP   A
RET
;@ROUTINE IN A OUT CARRY,ZERO,SIGN,PARITY,HALFCARRY
EN_IINDE:
CP   EN_IIX
JR   Z,AT_PYES
CP   EN_IIY
JR   Z,AT_PYES
CP   A
RET
;@ROUTINE IN A OUT CARRY CLOBBERS ZERO,SIGN,PARITY,HALFCARRY
EN_ICOND:
CP   EN_NZ
JR   C,AT_PNO
CP   EN_M+1
JR   C,AT_PYES
CP   A
RET
;@ROUTINE IN A OUT CARRY CLOBBERS ZERO,SIGN,PARITY,HALFCARRY
EN_IRCON:
CP   EN_NZ
JR   C,AT_PNO
CP   EN_CC+1
JR   C,AT_PYES
CP   A
RET
;@ROUTINE IN A OUT CARRY CLOBBERS ZERO,SIGN,PARITY,HALFCARRY
EN_IBIND:
CP   EN_BIT0
JR   C,AT_PNO
CP   EN_BIT7+1
JR   C,AT_PYES
;@ROUTINE IN A OUT CARRY MAYBE-OUT ZERO CLOBBERS SIGN,PARITY,HALFCARRY,ZERO
AT_PNO:
CP   A
RET
;@ROUTINE OUT CARRY CLOBBERS HALFCARRY
AT_PYES:
SCF
RET
EN_VCEND:
EN_RECBE:
;@ROUTINE IN IX,DE OUT A,DE,CARRY CLOBBERS BC,HL,ZERO,SIGN,PARITY,HALFCARRY
EN_NAME:
PUSH DE
CALL EN_VFORM
POP  DE
RET  C
PUSH DE
;@EXPECTOUT A
CALL EN_CORE
POP  DE
LD   C,A
LD   B,0
LD   HL,EN_SCRAT
LDIR
OR   A
RET
;@ROUTINE IN IX OUT A,CARRY CLOBBERS ZERO,SIGN,PARITY,HALFCARRY,B,DE,HL
EN_CORE:
LD   A,(IX+EN_MNEM)
CP   AT_MRET
JP   C,.COPCODE
JP   Z,.RET
CP   AT_MEX
JP   Z,.EX
CP   AT_MIM
JP   Z,.IM
CP   AT_MRST
JP   Z,.RST
CP   AT_MINC
JP   Z,.INCDEC
CP   AT_MDEC
JP   Z,.INCDEC
CP   AT_MPUSH
JP   Z,.STACK
CP   AT_MPOP
JP   Z,.STACK
CP   AT_MLD
JP   Z,.LD
CP   AT_MIN
JP   Z,.IN
CP   AT_MOUT
JP   Z,.OUT
CP   AT_MBIT
JP   C,AT_INVAL
CP   AT_MSET+1
JP   C,.BIT
CP   AT_MRLC
JP   C,AT_INVAL
CP   AT_MSRL+1
JP   C,.ROTATE
CP   AT_MADD
JP   C,AT_INVAL
CP   AT_MCP+1
JP   C,.ALU
CP   AT_MJP
JP   Z,.JP
CP   AT_MCALL
JP   Z,.CALL
CP   AT_MJR
JP   Z,.JR
JP   .DJNZ
.COPCODE:
DEC  A
ADD  A,A
LD   E,A
LD   D,0
LD   HL,EN_COPCO
ADD  HL,DE
LD   A,(HL)
LD   (EN_SCRAT+0),A
INC  HL
LD   A,(HL)
OR   A
JP   Z,.D1
LD   (EN_SCRAT+1),A
JP   .D2
.RET:
LD   A,(IX+EN_OP0)
CP   EN_NONE
JR   Z,.RETPLAIN
SUB  EN_NZ
ADD  A,A
ADD  A,A
ADD  A,A
ADD  A,$C0
JP   .SE1
.RETPLAIN:
LD   A,$C9
JP   .SE1
.EX:
LD   A,(IX+EN_OP0)
CP   EN_AF
JR   Z,.EXAF
CP   EN_DE
JR   Z,.EXDE
LD   A,(IX+EN_OP1)
CP   EN_HL
JR   Z,.EXSPHL
;@EXPECTOUT A
CALL EN_PFOP
LD   (EN_SCRAT+0),A
LD   A,$E3
LD   (EN_SCRAT+1),A
JP   .D2
.EXAF:
LD   A,$08
JP   .SE1
.EXDE:
LD   A,$EB
JP   .SE1
.EXSPHL:
LD   A,$E3
JP   .SE1
.IM:
LD   A,$ED
LD   (EN_SCRAT+0),A
LD   A,(IX+EN_OP0)
SUB  EN_IM0
LD   E,A
LD   D,0
LD   HL,EN_IOPCO
ADD  HL,DE
LD   A,(HL)
LD   (EN_SCRAT+1),A
JP   .D2
.RST:
LD   A,(IX+EN_OP0)
SUB  EN_RST0
ADD  A,A
ADD  A,A
ADD  A,A
ADD  A,$C7
JP   .SE1
.INCDEC:
LD   A,(IX+EN_MNEM)
SUB  AT_MINC-4
LD   B,A
LD   A,(IX+EN_OP0)
CALL EN_IR8
JR   C,.IDREGIST
LD   A,(IX+EN_OP0)
CALL EN_IR16
JR   C,.IDPAIR
LD   A,(IX+EN_OP0)
CP   EN_IX
JR   Z,.IDIPAIR
CP   EN_IY
JR   Z,.IDIPAIR
CALL EN_IHIND
JR   C,.IDHALF
LD   A,(IX+EN_OP0)
CP   EN_MEMHL
JR   Z,.IDMHL
;@EXPECTOUT A
CALL EN_PFOP
LD   (EN_SCRAT+0),A
LD   A,B
ADD  A,$30
LD   (EN_SCRAT+1),A
LD   A,(IX+EN_VAL0)
LD   (EN_SCRAT+2),A
JP   .D3
.IDREGIST:
LD   A,(IX+EN_OP0)
ADD  A,A
ADD  A,A
ADD  A,A
ADD  A,B
JP   .SE1
.IDPAIR:
LD   A,B
CP   4
LD   B,$03
JR   Z,.IDPBREAD
LD   B,$0B
.IDPBREAD:
LD   A,(IX+EN_OP0)
AND  3
ADD  A,A
ADD  A,A
ADD  A,A
ADD  A,A
ADD  A,B
JP   .SE1
.IDIPAIR:
PUSH AF
;@EXPECTOUT A
CALL EN_PFOP
LD   (EN_SCRAT+0),A
POP  AF
LD   A,B
CP   4
LD   A,$23
JR   Z,.IDIPREAD
LD   A,$2B
.IDIPREAD:
LD   (EN_SCRAT+1),A
JP   .D2
.IDHALF:
LD   A,(IX+EN_OP0)
PUSH AF
