POP  AF
AND  7
ADD  A,A
ADD  A,A
ADD  A,A
ADD  A,B
LD   (EN_SCRAT+1),A
JP   .D2
.IDMHL:
LD   A,B
ADD  A,$30
JP   .SE1
.STACK:
