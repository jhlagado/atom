;@EXPECTOUT A
CALL EN_PFOP
LD   (EN_SCRAT+0),A
LD   A,$F9
LD   (EN_SCRAT+1),A
JP   .D2
.LI16:
PUSH AF
;@EXPECTOUT A
CALL EN_PFOP
LD   (EN_SCRAT+0),A
