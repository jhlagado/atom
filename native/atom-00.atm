.LASPECIA:
LD   B,$57
CP   EN_I
JR   Z,.LASREADY
LD   B,$5F
.LASREADY:
LD   A,$ED
LD   (EN_SCRAT+0),A
LD   A,B
LD   (EN_SCRAT+1),A
JP   .D2
.LRINDEXE:
PUSH AF
;@EXPECTOUT A
CALL EN_PFOP
LD   (EN_SCRAT+0),A
