CP   AT_MPUSH
LD   B,$C5
JR   Z,.SBASE
LD   B,$C1
.SBASE:
LD   A,(IX+EN_OP0)
CP   EN_IX
JR   Z,.SINDEX
CP   EN_IY
JR   Z,.SINDEX
AND  3
ADD  A,A
ADD  A,A
ADD  A,A
ADD  A,A
ADD  A,B
JP   .SE1
.SINDEX:
;@EXPECTOUT A
CALL EN_PFOP
LD   (EN_SCRAT+0),A
LD   A,B
ADD  A,$20
LD   (EN_SCRAT+1),A
JP   .D2
EN_LEBEG EQU $
.LD:
LD   A,(IX+EN_OP0)
CALL EN_IR8
JP   C,.LDREG8
LD   A,(IX+EN_OP0)
CALL EN_IHIND
JP   C,.LDHALF
LD   A,(IX+EN_OP0)
CALL EN_IR16
JP   C,.LDREG16
LD   A,(IX+EN_OP0)
