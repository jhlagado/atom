AND  7
ADD  A,A
ADD  A,A
ADD  A,A
LD   B,A
LD   A,(IX+EN_OP1)
AND  7
ADD  A,B
ADD  A,$40
LD   (EN_SCRAT+1),A
JP   .D2
.LDREG16:
LD   A,(IX+EN_OP1)
CP   EN_IMM16
JR   Z,.LR1IMM
CP   EN_MABS
JR   Z,.LR1ABS
LD   A,(IX+EN_OP0)
CP   EN_SP
JR   Z,.LDSP
CP   EN_HL
LD   A,$62
JR   Z,.LDLEGACY
LD   A,$42
.LDLEGACY:
LD   (EN_SCRAT+0),A
ADD  A,9
LD   (EN_SCRAT+1),A
JP   .D2
.LR1IMM:
LD   A,(IX+EN_OP0)
AND  3
ADD  A,A
ADD  A,A
ADD  A,A
ADD  A,A
INC  A
LD   (EN_SCRAT+0),A
CALL AT_CV1TS
JP   .D3
.LR1ABS:
