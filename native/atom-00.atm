JR   Z,.LDAABS
CP   EN_MEMBC
JR   Z,.LAMPAIR
CP   EN_MEMDE
JR   Z,.LAMPAIR
CP   EN_I
JR   Z,.LASPECIA
CP   EN_R
JR   Z,.LASPECIA
